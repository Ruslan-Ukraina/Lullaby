+/* Lullaby: macOS scans a CAMetalLayer out straight to the display (the Metal HUD's
+   "Direct") only when no layer above it paints content of its own. In a winemac window two
+   do though the game's picture covers them: the window frame's layer has a background
+   colour (AppKit's, for a WineContentView that is not opaque) and the outer WineContentView's
+   layer holds the window surface image. While the metal view covers the whole window both
+   are cleared; Wine fills them again now and then, so this runs every second.
+   (WoWSilicon/WoWSilicon#25, athei/mtld3d#1123.) Main thread. */
+static void lullaby_clear_layers_over(NSView *metal_view)
+{
+    NSWindow *window = metal_view.window;
+    static int logged;
+    int cleared = 0;
+
+    if (!window || !window.isVisible) return;
+    /* The metal layer's own background shows nowhere it draws. */
+    if (metal_view.layer.backgroundColor) { metal_view.layer.backgroundColor = NULL; cleared++; }
+    /* Every view up to the window frame (Dormison's WineStageView, the outer and inner
+       WineContentView, NSNextStepFrame), as long as the metal view covers it. */
+    for (NSView *v = metal_view.superview; v; v = v.superview)
+    {
+        if (fabs(v.bounds.size.width - metal_view.bounds.size.width) > 1 ||
+            fabs(v.bounds.size.height - metal_view.bounds.size.height) > 1) break;
+        if (v.layer.contents) { v.layer.contents = nil; cleared++; }
+        if (v.layer.backgroundColor) { v.layer.backgroundColor = NULL; cleared++; }
+    }
+    if (cleared && logged++ < 5)
+        fprintf(stderr, "lullaby: direct display: cleared %d layer fills over the game's picture\n", cleared);
+}
+
 @implementation WineMetalLayer
 {
     os_unfair_lock stateLock;
@@ -185,10 +214,37 @@ - (id) init
         if ((self = [super init]))
