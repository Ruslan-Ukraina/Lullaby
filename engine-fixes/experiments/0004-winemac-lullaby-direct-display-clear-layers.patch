+            {
+                const char *value = getenv("LULLABY_NATIVE_FULLSCREEN");
+                if (value && value[0] == '1' && !value[1]) [super setOpaque:YES];
+            }
         }
         return self;
     }
 
+    /* Diagnostic only (LULLABY_TEST_NO_EDR=1): the layer refuses extended dynamic range, to
+       learn whether EDR keeps macOS from showing it straight on the display. Colours are wrong. */
+    - (void) setWantsExtendedDynamicRangeContent:(BOOL)value
+    {
+        const char *test = getenv("LULLABY_TEST_NO_EDR");
+        [super setWantsExtendedDynamicRangeContent:(test && test[0] == '1') ? NO : value];
+    }
+
+    - (void) setColorspace:(CGColorSpaceRef)space
+    {
+        const char *test = getenv("LULLABY_TEST_NO_EDR");
+        if (test && test[0] == '1')
+        {
+            CGColorSpaceRef srgb = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+            [super setColorspace:srgb];
+            CGColorSpaceRelease(srgb);
+        }
+        else
+            [super setColorspace:space];
+    }
