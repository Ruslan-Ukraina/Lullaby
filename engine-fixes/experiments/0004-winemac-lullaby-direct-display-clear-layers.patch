     - (void) setDisplaySyncEnabled:(BOOL)enabled
     {
         lullaby_layer_switches();
@@ -290,8 +346,25 @@ - (void) setWineView:(NSView*)view
             drawable = [super nextDrawable];
             if (drawable)
             {
+                static uint64_t count;
                 lullaby_layer_switches();
                 lullaby_feed_drawable(drawable);
+                if (getenv("LULLABY_DIRECT_DISPLAY") && !(count % 120) && [owner isKindOfClass:[NSView class]])
+                {
