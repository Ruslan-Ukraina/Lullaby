+/* Lullaby: macOS scans a CAMetalLayer out straight to the display (the Metal HUD's
+   "Direct") only when no layer of the window paints anything of its own around it. While a
+   game's Metal view covers its whole window, winemac then keeps the window surface image
+   out of the content view's layer, leaves the black backgrounds off, and calls the content
+   view opaque so AppKit does not fill the window frame either (WoWSilicon/WoWSilicon#25).
+   Only where lullaby_direct_display is set (macdrv_main.c). */
+extern int lullaby_direct_display;
+
+static BOOL lullaby_metal_covers(NSView *view)
+{
+    if (!lullaby_direct_display || !view) return NO;
+    for (NSView *sub in view.subviews)
+    {
+        NSRect frame;
+        if (sub.isHidden) continue;
+        frame = [view convertRect:sub.bounds fromView:sub];
+        if (fabs(frame.origin.x - view.bounds.origin.x) > 0.5 || fabs(frame.origin.y - view.bounds.origin.y) > 0.5 ||
+            fabs(frame.size.width - view.bounds.size.width) > 0.5 || fabs(frame.size.height - view.bounds.size.height) > 0.5)
+            continue;
+        if ([sub isKindOfClass:NSClassFromString(@"WineMetalView")]) return YES;
+        if (lullaby_metal_covers(sub)) return YES;
+    }
+    return NO;
+}
+
