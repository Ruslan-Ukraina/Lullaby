+    /* Lullaby (lullaby_direct_display): the game's window goes into macOS's full screen the
+       first time it can, as its green button would. The game then draws at the size of the
+       full-screen window (below the camera housing), which nothing scales. */
+    - (void) lullabyEnterNativeFullScreenSoon
+    {
+        static BOOL done;
+
+        if (!lullaby_direct_display || done) return;
+        if (!([self collectionBehavior] & NSWindowCollectionBehaviorFullScreenPrimary)) return;
+        if ([self styleMask] & NSWindowStyleMaskFullScreen) return;
+        done = YES;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            if (![self isVisible] || ([self styleMask] & NSWindowStyleMaskFullScreen)) return;
+            fprintf(stderr, "lullaby: direct display: entering full screen\n");
+            [NSApp activateIgnoringOtherApps:YES];
+            [self makeKeyAndOrderFront:nil];
+            [super toggleFullScreen:nil];
+        });
+    }
