+    /* Lullaby (lullaby_direct_display): extended dynamic range only for a picture that has
+       it. D3DMetal asks for EDR even when the game presents plain sRGB, and an EDR layer is
+       composited. */
+    - (void) setWantsExtendedDynamicRangeContent:(BOOL)value
+    {
+        extern int lullaby_direct_display;
+        if (value && lullaby_direct_display && self.colorspace)
+        {
+            CFStringRef name = CGColorSpaceCopyName(self.colorspace);
+            BOOL srgb = name && CFEqual(name, kCGColorSpaceSRGB);
+            if (name) CFRelease(name);
+            if (srgb)
+            {
+                fprintf(stderr, "lullaby: direct display: no EDR for an sRGB picture\n");
+                value = NO;
+            }
+        }
+        [super setWantsExtendedDynamicRangeContent:value];
+    }
+
+    - (void) setColorspace:(CGColorSpaceRef)space
+    {
+        extern int lullaby_direct_display;
+        [super setColorspace:space];
+        if (lullaby_direct_display && space && self.wantsExtendedDynamicRangeContent)
+        {
+            CFStringRef name = CGColorSpaceCopyName(space);
+            BOOL srgb = name && CFEqual(name, kCGColorSpaceSRGB);
+            if (name) CFRelease(name);
+            if (srgb) [self setWantsExtendedDynamicRangeContent:NO];
+        }
+    }
+
