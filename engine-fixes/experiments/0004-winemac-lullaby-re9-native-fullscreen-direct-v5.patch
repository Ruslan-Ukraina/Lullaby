    (d3dmetal_objc.m). Read here, on a Wine thread, for the renderer's threads have no TEB. */
 unsigned int lullaby_windows_pid;
 
+/* Lullaby: whether a game's picture may go straight to the display (cocoa_window.m,
+   lullaby_direct_display). Only Resident Evil Requiem for now, or LULLABY_DIRECT_DISPLAY=1. */
+int lullaby_direct_display;
+
+static void lullaby_init_direct_display(void)
+{
+    const UNICODE_STRING *image = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    const char *value = getenv("LULLABY_DIRECT_DISPLAY");
+    static const WCHAR re9[] = {'r','e','9','.','e','x','e'};
+    unsigned int len = image->Length / sizeof(WCHAR), start = len, i;
+
+    if (value && value[0]) { lullaby_direct_display = value[0] == '1'; return; }
+    while (start && image->Buffer[start - 1] != '\\' && image->Buffer[start - 1] != '/') start--;
+    if (len - start != ARRAY_SIZE(re9)) return;
+    for (i = 0; i < ARRAY_SIZE(re9); i++)
+    {
+        WCHAR c = image->Buffer[start + i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != re9[i]) return;
+    }
+    lullaby_direct_display = 1;
+}
