+    /* Lullaby (lullaby_direct_display): the game's window goes into macOS's full screen the
+       first time it can, as its green button would. The game then draws at the size of the
+       full-screen window (below the camera housing), which nothing scales. */
+    - (void) lullabyEnterNativeFullScreenSoon
+    {
+        static BOOL done;
+
+        if (!lullaby_direct_display || done) return;
+        if (!([self collectionBehavior] & NSWindowCollectionBehaviorFullScreenPrimary)) return;
+        if ([self styleMask] & NSWindowStyleMaskFullScreen) return;
+        done = YES;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            if (![self isVisible] || ([self styleMask] & NSWindowStyleMaskFullScreen)) return;
+            fprintf(stderr, "lullaby: direct display: entering full screen\n");
+            [NSApp activateIgnoringOtherApps:YES];
+            [self makeKeyAndOrderFront:nil];
+            [super toggleFullScreen:nil];
+        });
+    }
+
+    /* Lullaby (lullaby_direct_display): in full screen AppKit keeps its own layers behind the
+       content view — the window backdrop, the frame's background and, with Dormison's hidden
+       toolbar, a visual effect material over the whole window — and while they are there
+       the window is composited. With the game's Metal view covering the window they show
+       nowhere, so they are hidden until full screen ends. */
+    - (void) lullabyHideFrameLayers:(BOOL)hide
+    {
+        NSView *stage = self.contentView;
+        CALayer *root = stage.superview.layer;
+
+        if (!lullaby_direct_display || !root) return;
+        if (hide && !lullaby_metal_covers(stage)) return;
+        while (root.superlayer) root = root.superlayer;
+        __block int changed = 0;
+        __block void (^walk)(CALayer *);
+        walk = ^(CALayer *layer) {
+            for (CALayer *sub in [[layer.sublayers copy] autorelease])
+            {
+                BOOL holds_stage = NO;
+                for (CALayer *l = stage.layer; l; l = l.superlayer)
+                    if (l == sub) { holds_stage = YES; break; }
+                if (sub == stage.layer) continue;
+                if (holds_stage) { walk(sub); continue; }
+                if (sub.hidden != hide) { sub.hidden = hide; changed++; }
+            }
+        };
+        walk(root);
+        fprintf(stderr, "lullaby: direct display: %s %d frame layers\n", hide ? "hid" : "showed", changed);
+    }
+
     - (void) windowDidEnterFullScreen:(NSNotification*)notification
     {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            if (!([self styleMask] & NSWindowStyleMaskFullScreen)) return;
+            /* The hidden toolbar keeps a full-screen toolbar window over the picture. */
+            if (lullaby_direct_display && [self toolbar] && lullaby_metal_covers(self.contentView))
+            {
+                [self setToolbar:nil];
+                fprintf(stderr, "lullaby: direct display: toolbar off in full screen\n");
+            }
+            [self lullabyHideFrameLayers:YES];
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+                for (NSWindow *w in [NSApp windows])
+                {
+                    if (w.isVisible && w != self && w.alphaValue == 0)
+                    {
+                        [w orderOut:nil];
+                        fprintf(stderr, "lullaby: direct display: ordered out %s\n", [NSStringFromClass([w class]) UTF8String]);
+                    }
+                }
+                {
+                    NSMutableString *out = [NSMutableString string];
+                    for (NSView *v = [(WineWindow*)self wineContentView]; v; v = v.superview)
+                    {
+                        CALayer *l = v.layer;
+                        [out appendFormat:@"\n  %@ layer %@ frame %@ scale %.2f transform-identity %d sublayer-identity %d gravity %@ geometryFlipped %d masks %d filters %lu",
+                            NSStringFromClass([v class]), NSStringFromClass([l class]), NSStringFromRect(NSRectFromCGRect(l.frame)),
+                            l.contentsScale, (int)CATransform3DIsIdentity(l.transform), (int)CATransform3DIsIdentity(l.sublayerTransform),
+                            l.contentsGravity, (int)l.geometryFlipped, (int)l.masksToBounds, (unsigned long)l.filters.count];
+                        for (CALayer *sub in l.sublayers)
+                            if ([sub isKindOfClass:[CAMetalLayer class]])
+                                [out appendFormat:@"\n    metal %@ frame %@ scale %.2f transform-identity %d format %lu drawable %.0fx%.0f opaque %d fbonly %d colorspace %@ edr %d mag %@",
+                                    NSStringFromClass([sub class]), NSStringFromRect(NSRectFromCGRect(sub.frame)), sub.contentsScale,
+                                    (int)CATransform3DIsIdentity(sub.transform), (unsigned long)((CAMetalLayer*)sub).pixelFormat,
+                                    ((CAMetalLayer*)sub).drawableSize.width, ((CAMetalLayer*)sub).drawableSize.height, (int)sub.opaque,
+                                    (int)((CAMetalLayer*)sub).framebufferOnly,
+                                    ((CAMetalLayer*)sub).colorspace ? (NSString*)CGColorSpaceCopyName(((CAMetalLayer*)sub).colorspace) : @"none",
+                                    (int)((CAMetalLayer*)sub).wantsExtendedDynamicRangeContent, sub.magnificationFilter];
+                    }
+                    fprintf(stderr, "lullaby: direct display: chain%s\n", [out UTF8String]);
+                    /* Rounded, masked window corners need the compositor. */
+                    for (NSView *v = [(WineWindow*)self wineContentView]; v; v = v.superview)
+                    {
+                        CALayer *l = v.layer;
+                        fprintf(stderr, "lullaby: direct display: %s corner %.1f masks %d mask %d\n",
+                                [NSStringFromClass([v class]) UTF8String], l.cornerRadius, (int)l.masksToBounds, l.mask != nil);
+                        if (l.cornerRadius) l.cornerRadius = 0;
+                        if (l.masksToBounds) l.masksToBounds = NO;
+                    }
+                    for (CALayer *l = [(WineWindow*)self wineContentView].layer; l; l = l.superlayer)
+                    {
+                        if (l.cornerRadius) { fprintf(stderr, "lullaby: direct display: superlayer %s corner %.1f\n", [NSStringFromClass([l class]) UTF8String], l.cornerRadius); l.cornerRadius = 0; }
+                        if (l.masksToBounds) l.masksToBounds = NO;
+                    }
+                    for (NSView *v in [(WineWindow*)self wineContentView].subviews)
+                        for (NSView *m in v.subviews)
+                            if ([m.layer isKindOfClass:[CAMetalLayer class]])
+                            {
+                                CAMetalLayer *ml = (CAMetalLayer*)m.layer;
+                                fprintf(stderr, "lullaby: direct display: metal format %lu drawable %.0fx%.0f opaque %d fbonly %d edr %d corner %.1f transform-identity %d\n",
+                                        (unsigned long)ml.pixelFormat, ml.drawableSize.width, ml.drawableSize.height, (int)ml.opaque,
+                                        (int)ml.framebufferOnly, (int)ml.wantsExtendedDynamicRangeContent, ml.cornerRadius,
+                                        (int)CATransform3DIsIdentity(ml.transform));
+                            }
+                }
+            });
+        });
         enteringFullScreen = FALSE;
         enteredFullScreenTime = [[NSProcessInfo processInfo] systemUptime];
         if (pendingOrderOut)
@@ -4187,6 +4355,7 @@ - (void) attachFullScreenToolbar
 
