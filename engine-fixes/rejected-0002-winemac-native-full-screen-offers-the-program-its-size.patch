Lullaby-Dormison, 2026-10-10. In native full screen (the green button) a window whose program
made it fixed-size is scaled by Dormison at the size the program drew at: Resident Evil Requiem
in its windowed mode showed 2294x1496 with a black strip and bars. Its program is now told the
full-screen size, as a resizable window's is; RE9 re-renders at 3024x1898 (checked live with a
SetWindowPos probe), and the scaler, left on, presents it 1:1. A first version that also turned
the scaler off showed the picture zoomed into the top-left corner (owner's check, 10.10).
LULLABY_FULLSCREEN_SCALES=1 keeps the scaling only.

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index bdd9e261b2..62c68f548e 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -3996,10 +3996,35 @@ - (void) windowDidEndLiveResize:(NSNotification *)notification
         }
     }
 
+    /* Lullaby: whether native full screen tells a scaled window's program the
+       full-screen size (LULLABY_FULLSCREEN_SCALES=1 keeps Dormison's scaling only). */
+    static BOOL fullscreen_offers_size(void)
+    {
+        static int on = -1;
+        if (on < 0)
+        {
+            const char* env = getenv("LULLABY_FULLSCREEN_SCALES");
+            on = !(env && env[0] == '1');
+        }
+        return on;
+    }
+
     - (void) windowDidEnterFullScreen:(NSNotification*)notification
     {
         enteringFullScreen = FALSE;
         enteredFullScreenTime = [[NSProcessInfo processInfo] systemUptime];
+        /* Lullaby: a window the program made fixed-size is scaled at the size it drew
+           at. Its program is now told the full-screen size, as a resizable window's is: one
+           that re-renders at it fills the screen at the display's resolution, and the scaler,
+           left on, then presents it 1:1; one that keeps its size stays scaled as before.
+           windowWillExitFullScreen: hands it the windowed size back. */
+        if (presentationScalable && !presentationWindowed && fullscreen_offers_size() &&
+            ([self styleMask] & NSWindowStyleMaskFullScreen))
+        {
+            presentation_log(self, "full screen tells the program its size", self.frame, wineFrame,
+                             [wineContentView frame]);
+            [self postWindowFrameChanged:self.frame fullscreen:TRUE resizing:FALSE skipSizeMove:FALSE];
+        }
         if (pendingOrderOut)
             [self doOrderOut];
     }
