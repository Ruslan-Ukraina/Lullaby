@@ -509,7 +499,7 @@ int write_process_memory( struct process *process, client_ptr_t ptr, data_size_t
             }
 
             /* FIXME: See the above Rosetta remark. */
-            if (!is_rosetta() && !(info.protection & VM_PROT_WRITE))
