WFUSync: look at the object again before blocking (a real spin), and before registering a wait slot.

For WineForge 0.6.0.7 (Wine 11.20), dlls/ntdll/unix/wfusync.c. Lullaby, 2026-10-18. LGPL-2.1-or-later like Wine.
Not measured yet: this patch is compiled, not benchmarked (see docs/WINEFORGE_PORT.md, "WFUSync").

What was there: wfusync_adaptive_spin() counted to WFUSYNC_SPIN_LIMIT (32) and the callers answered
TRUE with `continue` at the top of the loop, before the loop body looked at the object. The spin was
32 increments and nothing else: a wait went straight to os_sync_wait_on_address. msync+ (Dormison)
spends a real budget looking at the object, which is what lets a partner that answers within a few
microseconds be caught without a block (its 1.3 us wake in the syncbench `multi` case).

What this does:
 - Waits on one object (event, mutex, semaphore): the spin is taken after the object was looked at
   and found not ready, so every spin step is a look (with the stale-state checks the loop already
   had), then a PAUSE/YIELD. Budget: WINEWFUSYNC_SPIN looks, default 32 (the old constant), 0 = none.
 - Waits on several objects (WaitAny, WaitAll): before the wait slot is registered, the objects are
   looked at WINEWFUSYNC_SPIN_MULTI times (default 32). A blocking wait on several objects costs
   server requests (get slot once per thread; register, wake, unregister for every wait), which is
   why its latency equals the wineserver's; a signal that arrives inside the spin never reaches them.
 - Both numbers are read once, with WINEWFUSYNC, capped at 1000000.
Nothing else changes: no protocol.def change, no server change, the fallbacks to the server stay.
Try 256 and 1024 on syncbench (perf/syncbench.sh): the cost of a larger budget is processor time.
KNOWN FAULT: with WINEWFUSYNC_SPIN(_MULTI)=4096 a full syncbench run hung in 3 of 8 tries (the wineserver
spins in lock_state of server/wfusync.c, waiting for a state lock a client holds); 0 of 8 at 1024 and below,
and 0 of 8 without this patch. Not root-caused. Keep the budget at 1024 or less and do not ship a larger default.

diff --git a/dlls/ntdll/unix/wfusync.c b/dlls/ntdll/unix/wfusync.c
index b83c406e..ac3ce633 100644
--- a/dlls/ntdll/unix/wfusync.c
+++ b/dlls/ntdll/unix/wfusync.c
@@ -131,11 +131,42 @@ static void unlock_wfusync_cache(void)
 #endif
 }
 
+/* How many times a wait looks at the object again before it blocks. One look is a few
+ * nanoseconds; WINEWFUSYNC_SPIN is for waits on one object, WINEWFUSYNC_SPIN_MULTI for waits on
+ * several, where a look at all of them comes before the wait slot is registered with the server
+ * (a registration, the wake that follows it and the unregistration are three server requests).
+ * 0 turns the looking off. Capped at 1000000, as the msync spin is. */
+static unsigned int wfusync_spin_limit = WFUSYNC_SPIN_LIMIT;
+static unsigned int wfusync_spin_limit_multi = WFUSYNC_SPIN_LIMIT;
+
+static unsigned int wfusync_env_spin( const char *name, unsigned int def )
+{
+    const char *env = getenv( name );
+    unsigned long value;
+    char *end;
+
+    if (!env || !*env) return def;
+    value = strtoul( env, &end, 10 );
+    if (*end) return def;
+    return value > 1000000 ? 1000000 : (unsigned int)value;
+}
+
+static inline void wfusync_cpu_relax(void)
+{
+#if defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#elif defined(__aarch64__)
+    __asm__ __volatile__( "yield" );
+#endif
+}
+
 int do_wfusync(void)
 {
     if (do_wfusync_env_cached == -1)
     {
         const char *env = getenv( "WINEWFUSYNC" );
+        wfusync_spin_limit = wfusync_env_spin( "WINEWFUSYNC_SPIN", WFUSYNC_SPIN_LIMIT );
+        wfusync_spin_limit_multi = wfusync_env_spin( "WINEWFUSYNC_SPIN_MULTI", WFUSYNC_SPIN_LIMIT );
         do_wfusync_env_cached = (env && atoi( env )) ? 1 : 0;
     }
 
@@ -1125,11 +1156,14 @@ static int compare_timespec( const struct timespec *left, const struct timespec
     return 0;
 }
 
+/* TRUE while the budget lasts. The callers look at the object again before they come back
+ * here (they used to `continue` at once, so the budget was spent without a single look). */
 static BOOL wfusync_adaptive_spin( unsigned int *attempts )
 {
-    if (*attempts >= WFUSYNC_SPIN_LIMIT) return FALSE;
+    if (*attempts >= wfusync_spin_limit) return FALSE;
 
     (*attempts)++;
+    wfusync_cpu_relax();
     return TRUE;
 }
 
@@ -1199,7 +1233,6 @@ NTSTATUS wfusync_wait_event( HANDLE handle, BOOLEAN alertable, const LARGE_INTEG
         struct timespec *wait_timeout_ptr = NULL;
         unsigned long long ns;
 
-        if (wfusync_adaptive_spin( &attempts )) continue;
         if (__atomic_load_n( &state->generation, __ATOMIC_SEQ_CST ) != generation ||
             wfusync_state_type( state ) != INPROC_SYNC_EVENT ||
             wfusync_has_server_waiters( state ))
@@ -1208,6 +1241,7 @@ NTSTATUS wfusync_wait_event( HANDLE handle, BOOLEAN alertable, const LARGE_INTEG
             return STATUS_NOT_IMPLEMENTED;
         }
         if ((ret = consume_event_state( state )) == STATUS_WAIT_0) break;
+        if (wfusync_adaptive_spin( &attempts )) continue;
         if (timeout)
         {
             get_now_abs( &now );
@@ -1304,7 +1338,6 @@ NTSTATUS wfusync_wait_mutex( HANDLE handle, BOOLEAN alertable, const LARGE_INTEG
         unsigned long long ns;
         int owner;
 
-        if (wfusync_adaptive_spin( &attempts )) continue;
         if (__atomic_load_n( &state->generation, __ATOMIC_SEQ_CST ) != generation ||
             wfusync_state_type( state ) != INPROC_SYNC_MUTEX ||
             wfusync_has_server_waiters( state ))
@@ -1319,6 +1352,7 @@ NTSTATUS wfusync_wait_mutex( HANDLE handle, BOOLEAN alertable, const LARGE_INTEG
             break;
         }
         if (ret != STATUS_TIMEOUT) return ret;
+        if (wfusync_adaptive_spin( &attempts )) continue;
         if (timeout)
         {
             get_now_abs( &now );
@@ -1417,7 +1451,6 @@ NTSTATUS wfusync_wait_semaphore( HANDLE handle, BOOLEAN alertable, const LARGE_I
         struct timespec *wait_timeout_ptr = NULL;
         unsigned long long ns;
 
-        if (wfusync_adaptive_spin( &attempts )) continue;
         if (__atomic_load_n( &state->generation, __ATOMIC_SEQ_CST ) != generation ||
             wfusync_state_type( state ) != INPROC_SYNC_SEMAPHORE ||
             wfusync_has_server_waiters( state ))
@@ -1426,6 +1459,7 @@ NTSTATUS wfusync_wait_semaphore( HANDLE handle, BOOLEAN alertable, const LARGE_I
             return STATUS_NOT_IMPLEMENTED;
         }
         if ((ret = consume_semaphore_state( state )) == STATUS_WAIT_0) break;
+        if (wfusync_adaptive_spin( &attempts )) continue;
         if (timeout)
         {
             get_now_abs( &now );
@@ -1768,6 +1802,18 @@ NTSTATUS wfusync_wait_multiple( DWORD count, const HANDLE *handles, WAIT_TYPE ty
             entries[i * 3 + 1] = generations[i];
             entries[i * 3 + 2] = types[i];
         }
+        for (i = 0; i < wfusync_spin_limit_multi; i++)
+        {
+            wfusync_cpu_relax();
+            ret = try_wait_all_local( states, shm_idxs, generations, types, count );
+            if (ret == STATUS_WAIT_0 || ret == STATUS_ABANDONED_WAIT_0)
+            {
+                if (ret == STATUS_ABANDONED_WAIT_0)
+                    refresh_waitall_mutex_generations( handles, states, types, count );
+                return ret;
+            }
+            if (ret != STATUS_TIMEOUT) break;
+        }
         if (timeout && !timeout->QuadPart)
         {
             ret = try_wait_all_wfusync( entries, count, 0 );
@@ -1850,6 +1896,18 @@ NTSTATUS wfusync_wait_multiple( DWORD count, const HANDLE *handles, WAIT_TYPE ty
         return STATUS_TIMEOUT;
     }
 
+    for (i = 0; i < wfusync_spin_limit_multi; i++)
+    {
+        wfusync_cpu_relax();
+        ret = consume_waitany_states( handles, states, generations, types, count );
+        if (ret != STATUS_TIMEOUT)
+        {
+            if (ret == STATUS_NOT_IMPLEMENTED)
+                return STATUS_NOT_IMPLEMENTED;
+            return ret;
+        }
+    }
+
     if ((ret = get_wfusync_wait_slot()))
         return ret == STATUS_NOT_IMPLEMENTED ? STATUS_NOT_IMPLEMENTED : ret;
     if (timeout) get_relative_timeout_abs( timeout, &deadline );
