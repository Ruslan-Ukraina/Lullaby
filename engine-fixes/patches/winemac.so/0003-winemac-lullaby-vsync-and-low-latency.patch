+/* Lullaby's switches for the D3DMetal layer, read once per process from the env files.
+ *
+ * LULLABY_FORCE_VSYNC=1: the layer stays in step with the display. D3DMetal sets
+ *   displaySyncEnabled from the game's sync interval, and a game with frame generation
+ *   on presents with V-Sync off, which tears; the generated frames then go out paced.
+ * LULLABY_LOW_LATENCY=1: what NVIDIA Reflex does for the frame queue, which D3DMetal's
+ *   NvAPI_D3D_Sleep leaves undone (it returns NVAPI_OK and nothing else): at most two
+ *   drawables in flight instead of three, and, unless a frame rate limit is set, the
+ *   frame limiter holds presents three frames under the display's refresh rate, so a
+ *   synced layer never builds a queue the input waits behind. */
+static int lullaby_force_vsync = -1, lullaby_low_latency = -1;
+
+static int lullaby_env_on(const char *name)
+{
+    const char *value = getenv(name);
+    return value && value[0] == '1' && !value[1];
+}
+
+static void lullaby_layer_switches(void)
+{
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        lullaby_force_vsync = lullaby_env_on("LULLABY_FORCE_VSYNC");
+        lullaby_low_latency = lullaby_env_on("LULLABY_LOW_LATENCY");
+        if (lullaby_low_latency && __atomic_load_n(&frame_rate_limit, __ATOMIC_RELAXED) == 0)
+        {
+            CGDisplayModeRef mode = CGDisplayCopyDisplayMode(CGMainDisplayID());
+            int hz = mode ? (int)(CGDisplayModeGetRefreshRate(mode) + 0.5) : 0;
+            if (mode) CGDisplayModeRelease(mode);
+            if (hz <= 0) hz = 60;
+            sevo_limiter_set(hz > 30 ? hz - 3 : hz);
+        }
+        fprintf(stderr, "lullaby: D3DMetal layer: force vsync %d, low latency %d, frame limit %d\n",
+                lullaby_force_vsync, lullaby_low_latency, __atomic_load_n(&frame_rate_limit, __ATOMIC_RELAXED));
+    });
+}
+
 @implementation WineMetalLayer
 {
     os_unfair_lock stateLock;
@@ -53,6 +92,28 @@ @implementation WineMetalLayer
