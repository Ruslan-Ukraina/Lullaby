 }
 
+    - (id) init
+    {
+        if ((self = [super init]))
+        {
+            lullaby_layer_switches();
+            if (lullaby_low_latency) [super setMaximumDrawableCount:2];
+        }
+        return self;
+    }
+
+    - (void) setDisplaySyncEnabled:(BOOL)enabled
+    {
+        lullaby_layer_switches();
+        [super setDisplaySyncEnabled:lullaby_force_vsync ? YES : enabled];
+    }
+
+    - (void) setMaximumDrawableCount:(NSUInteger)count
+    {
+        lullaby_layer_switches();
+        [super setMaximumDrawableCount:lullaby_low_latency && count > 2 ? 2 : count];
+    }
