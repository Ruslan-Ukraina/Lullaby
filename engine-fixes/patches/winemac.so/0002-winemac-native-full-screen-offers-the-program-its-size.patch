+    /* NotProton: whether native full screen offers a scaled window the screen's size
+       first (NOTPROTON_FULLSCREEN_SCALES=1 keeps Dormison's scaling only). */
+    static BOOL fullscreen_offers_size(void)
+    {
+        static int on = -1;
+        if (on < 0)
+        {
+            const char* env = getenv("NOTPROTON_FULLSCREEN_SCALES");
+            on = !(env && env[0] == '1');
+        }
+        return on;
+    }
