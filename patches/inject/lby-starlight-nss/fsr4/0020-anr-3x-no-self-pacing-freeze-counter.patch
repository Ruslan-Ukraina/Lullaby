+            snprintf(line, sizeof line, "freeze #%u: %.0f ms between the game's presents (usual %.1f); ANR encode %.1f ms, "
+                     "wait for drawable %.1f ms, extra frame %.1f ms, FG frames %u, extra skipped %u%s%s -> %s | so far: "
+                     "drawable %u, encode %u, build %u, game %u, other %u", count, gap, ema, enc, wait, extra, encodes,
+                     skipped, rebuilt ? ", network built" : "", fellBack ? ", ANR fell back to MetalFX" : "", causes[c],
+                     byCause[0], byCause[1], byCause[2], byCause[3], byCause[4]);
+            logHook(line, Nil);
+        }
+    } else ema = 0.95 * ema + 0.05 * gap;
+}
