 // Lullaby (patch 0014): how evenly the game's frames reach present() in frame generation. Every 600 presents the hook
 // log gets the mean interval, the 95th percentile, the share of presents closer than 2 ms to the one before (bunched:
 // the eye sees one frame) and of gaps over twice the mean (a hitch). Time is taken when present() is called.
+// Patch 0020: what reaches the screen. Each presented drawable reports its presentedTime (0 = replaced before it was
+// shown); every 600 the log gets how many were really seen per second and how evenly.
+static void lbyScreenStats(id drawable) {
+    if (!drawable || ![drawable respondsToSelector:@selector(addPresentedHandler:)]) return;
+    [(id<MTLDrawable>)drawable addPresentedHandler:^(id<MTLDrawable> d) {
+        static std::mutex m; static double last = 0; static unsigned total = 0, dropped = 0;
+        static std::vector<double> iv; static double first = 0;
+        std::lock_guard<std::mutex> g(m);
+        const double t = d.presentedTime;
+        ++total;
+        if (t <= 0) ++dropped;
+        else { if (last > 0) iv.push_back((t - last) * 1000); else first = t; last = t; }
+        if (total < 600) return;
+        double span = 0; for (double v : iv) span += v;
+        std::vector<double> s = iv; std::sort(s.begin(), s.end());
+        size_t uneven = 0; const double mean = iv.empty() ? 0 : span / iv.size();
+        for (double v : iv) if (v > 1.5 * mean) ++uneven;
+        char line[240];
+        snprintf(line, sizeof line, "on screen: %u presented, %u never shown, %.0f shown/s, interval mean %.2f p95 %.2f max %.1f ms, longer than 1.5x mean %.1f %%",
+                 total, dropped, span > 0 ? 1000.0 * iv.size() / span : 0.0, mean, s.empty() ? 0 : s[s.size() * 95 / 100],
+                 s.empty() ? 0 : s.back(), iv.empty() ? 0 : 100.0 * uneven / iv.size());
+        logHook(line, Nil);
+        total = dropped = 0; iv.clear(); last = 0; (void)first;
+    }];
+}
+// Patch 0020: freeze counter. Between two of the game's presents the hook adds up where ANR itself spent time; a gap
+// longer than 2.5x the usual frame (and over 40 ms) gets a line with those parts and the likely cause.
+static void lbyFreezeCheck() {
+    static std::mutex m; static double last = 0, ema = 0; static unsigned builds = 0, inactive = 0, count = 0;
+    static unsigned byCause[5];
+    std::lock_guard<std::mutex> g(m);
+    const double now = CFAbsoluteTimeGetCurrent();
+    const double enc = g_hzEncodeMs.exchange(0), wait = g_hzWaitMs.exchange(0), extra = g_hzExtraMs.exchange(0);
+    const unsigned skipped = g_hzSkipped.exchange(0), encodes = g_hzEncodes.exchange(0);
+    const unsigned b = lby_anr_builds.load(), in = lby_anr_inactive.load();
+    const bool rebuilt = b != builds, fellBack = in != inactive; builds = b; inactive = in;
+    if (last <= 0) { last = now; return; }
+    const double gap = (now - last) * 1000;
+    if (gap < 3) return;   // the second of D3DMetal's back-to-back pair: one frame of the game
+    last = now;
+    if (ema <= 0) ema = gap;
+    if (gap > 40 && gap > 2.5 * ema) {
+        const char *causes[5] = {"ANR waiting for a free drawable", "ANR encode on the CPU", "ANR building its network",
+                                 "the game sent no frame (game, CPU, loading: not ANR)", "outside ANR (GPU or the screen queue)"};
+        int c = wait > 0.4 * gap ? 0 : enc > 0.4 * gap ? 1 : rebuilt ? 2 : encodes == 0 ? 3 : 4;
+        ++byCause[c]; ++count;
