+// Patch 0015: the extra frame for a pair the caller has recognised as an interpolated present. The oldest waiting entry
+// is this pair's; more than two waiting means presents were missed, and the surplus oldest ones are dropped so the
+// sequence comes back into step by itself.
+int fsr4_anr_take_extra(void *device, void **outExtraTexture, double *outStepSeconds, uint64_t *outTicket) {
+    if (outExtraTexture) *outExtraTexture = nullptr;
+    if (outStepSeconds) *outStepSeconds = 0.0;
+    if (outTicket) *outTicket = 0;
+    if (fsr4_anr_selected_mode() != 2) return 0;
+    auto &state = live_state();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    prune_stale_extras_locked(state, std::chrono::steady_clock::now());
+    const uintptr_t devKey = (uintptr_t)device;
+    size_t waiting = 0;
+    for (auto &e : state.pendingExtras) if ((!devKey || e.device == devKey) && e.phase == PresentPhase::WaitingInterp) ++waiting;
+    for (auto it = state.pendingExtras.begin(); it != state.pendingExtras.end();) {
+        if ((devKey && it->device != devKey) || it->phase != PresentPhase::WaitingInterp) { ++it; continue; }
+        if (waiting > 2) { release_slot_ticket_locked(state, it->ticket); it = state.pendingExtras.erase(it); --waiting; continue; }
+        if (outExtraTexture) *outExtraTexture = (__bridge_retained void *)it->texture;
+        if (outStepSeconds) *outStepSeconds = it->stepSeconds;
+        if (outTicket) *outTicket = it->ticket;
+        it->texture = nil;
+        state.pendingExtras.erase(it);
+        return 1;
+    }
+    return 0;
 }
 
