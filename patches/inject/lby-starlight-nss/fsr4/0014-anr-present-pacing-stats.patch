+// Lullaby (patch 0014): how evenly the game's frames reach present() in frame generation. Every 600 presents the hook
+// log gets the mean interval, the 95th percentile, the share of presents closer than 2 ms to the one before (bunched:
+// the eye sees one frame) and of gaps over twice the mean (a hitch). Time is taken when present() is called.
+static void lbyPresentStats() {
+    static std::mutex m; static std::vector<double> iv; static double last = 0;
+    std::lock_guard<std::mutex> g(m);
+    const double now = CFAbsoluteTimeGetCurrent();
+    if (last > 0) iv.push_back((now - last) * 1000);
+    last = now;
+    if (iv.size() < 600) return;
+    std::vector<double> s = iv; std::sort(s.begin(), s.end());
+    double sum = 0; for (double v : iv) sum += v;
+    const double mean = sum / iv.size();
+    size_t bunched = 0, hitch = 0; for (double v : iv) { if (v < 2.0) ++bunched; if (v > 2 * mean) ++hitch; }
+    char line[220];
+    snprintf(line, sizeof line, "present pacing: %zu intervals, mean %.2f ms (%.0f/s), p95 %.2f ms, max %.1f ms, bunched <2 ms %.0f %%, gaps >2x mean %.1f %%",
+             iv.size(), mean, 1000 / mean, s[s.size() * 95 / 100], s.back(), 100.0 * bunched / iv.size(), 100.0 * hitch / iv.size());
+    logHook(line, Nil);
+    iv.clear();
+}
