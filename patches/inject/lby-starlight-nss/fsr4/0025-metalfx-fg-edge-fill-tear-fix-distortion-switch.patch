+// Patch 0025 (FSR4_MFX_EDGE=1 or mfxedge=on): where the screen edge brings in what the last frame did not show (the
+// camera turns), MetalFX fills the in-between frame with a shifted copy, a band as wide as the turn. Each pixel of the
+// generated frame whose point was outside the last frame (half its motion back) takes the new real frame's pixel there.
+static bool lbyMfxEdgeWanted() {
+    const int live = fsr4_mfx_live_edge();
+    if (live >= 0) return live > 0;
+    static const bool on = [] { const char *e = getenv("FSR4_MFX_EDGE"); return e && e[0] == '1'; }();
+    return on;
+}
+static id<MTLComputePipelineState> edgePSO(id<MTLDevice> device) {
+    static std::mutex lock; static id<MTLComputePipelineState> pso; static bool pending = false, failed = false;
+    std::lock_guard<std::mutex> guard(lock);
+    if (pso || pending || failed) return pso;
+    pending = true;
+    id<MTLDevice> dev = device;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSString *src = @"#include <metal_stdlib>\n"
+            "using namespace metal;\n"
+            "struct E { float2 mvScale; float2 margin; float fix, agree, apart, pad; };\n"
+            "static float lum(float3 c) { c = max(c, 0.0f); return dot(c / (1.0f + c), float3(0.2126f, 0.7152f, 0.0722f)); }\n"
+            "kernel void lby_edge(texture2d<float, access::read_write> gen [[texture(0)]], texture2d<float, access::sample> cur [[texture(1)]],\n"
+            "                     texture2d<float, access::sample> mv [[texture(2)]], texture2d<float, access::sample> prev [[texture(3)]],\n"
+            "                     constant E &e [[buffer(0)]],\n"
+            "                     uint2 g [[thread_position_in_grid]]) {\n"
+            "    const float2 size = float2(gen.get_width(), gen.get_height()); if (g.x >= size.x || g.y >= size.y) return;\n"
+            "    constexpr sampler s(coord::normalized, address::clamp_to_edge, filter::nearest);\n"
+            "    const float2 uv = (float2(g) + 0.5f) / size;\n"
+            "    const float2 m = mv.sample(s, uv).xy * e.mvScale / float2(mv.get_width(), mv.get_height());\n"
+            "    const float2 back = uv + 0.5f * m;\n"
+            "    constexpr sampler lin(coord::normalized, address::clamp_to_edge, filter::linear);\n"
+            "    // the new frame where this point is half a frame later (motion points from the new frame to the last)\n"
+            "    const float4 a = cur.sample(lin, uv - 0.5f * m);\n"
+            "    if (any(back < -e.margin) || any(back > 1.0f + e.margin)) { gen.write(a, g); return; }\n"
+            "    if (e.fix <= 0.0f) return;\n"
+            "    // MetalFX far from both frames carried to the middle while those two agree: a tear, not a reveal\n"
+            "    const float4 b = prev.sample(lin, uv + 0.5f * m), o = gen.read(g);\n"
+            "    const float la = lum(a.rgb), lb = lum(b.rgb), lo = lum(o.rgb);\n"
+            "    if (fabs(la - lb) < e.agree && min(fabs(lo - la), fabs(lo - lb)) > e.apart) gen.write(float4(0.5f * (a.rgb + b.rgb), o.a), g);\n"
+            "}\n";
+        NSError *e = nil;
+        id<MTLLibrary> lib = [dev newLibraryWithSource:src options:nil error:&e];
+        id<MTLFunction> fn = [lib newFunctionWithName:@"lby_edge"];
+        id<MTLComputePipelineState> p = fn ? [dev newComputePipelineStateWithFunction:fn error:&e] : nil;
+        std::lock_guard<std::mutex> g2(lock);
+        pso = p; pending = false; failed = p == nil;
+        logHook(p ? "MetalFX FG screen-edge fill on" : "MetalFX FG screen-edge fill: kernel unavailable", Nil);
+    });
+    return nil;
+}
