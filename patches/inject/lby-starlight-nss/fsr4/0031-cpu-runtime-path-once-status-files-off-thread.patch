+// Lullaby (patch 0031): the status file is written off the game's thread (it was opened, written and renamed on it
+// twice a second); here only the text is made.
+static void lby_write_file_async(std::string path, std::string text) {
+    // the block keeps its own copies: a reference parameter would be captured as a reference to the caller's string,
+    // gone by the time the block runs (the status then landed in whatever string reused that memory)
+    static dispatch_queue_t q = dispatch_queue_create("org.lullaby.anr-status", DISPATCH_QUEUE_SERIAL);
+    const std::string target = path, body = text;
+    dispatch_async(q, ^{
+        const std::string &path = target; const std::string &text = body;
+        const std::string temporary = path + ".tmp";
+        if (FILE *f = fopen(temporary.c_str(), "w")) {
+            fwrite(text.data(), 1, text.size(), f);
+            fclose(f);
+            rename(temporary.c_str(), path.c_str());
+        }
+    });
+}
