+static std::string runtime_path_uncached(uint32_t width, uint32_t height);
+// Lullaby (patch 0031): the runtime's directory is looked up once per size. It ran every frame: two file checks and
+// the manifest parsed as JSON on the game's thread, 78 % of ANR's CPU time per frame on the stand (Rosetta: ~0.6 ms).
 std::string runtime_path(uint32_t width, uint32_t height) {
+    static std::mutex lock;
+    static std::map<std::pair<std::string, uint64_t>, std::string> known;
+    const char *base = getenv("FSR4_ANR_RUNTIME");
+    const auto key = std::make_pair(std::string(base ? base : ""), (uint64_t(width) << 32) | height);
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        auto it = known.find(key);
+        if (it != known.end()) return it->second;
+    }
+    std::string found = runtime_path_uncached(width, height);
+    std::lock_guard<std::mutex> guard(lock);
+    if (!found.empty()) known[key] = found;   // a missing runtime is looked up again (it may be installed meanwhile)
+    return found;
+}
