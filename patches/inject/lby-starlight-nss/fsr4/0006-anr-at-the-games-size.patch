+static id<MTLComputePipelineState> resamplePSO(id<MTLDevice> device) {
+    static std::mutex lock;
+    static std::map<uintptr_t, id<MTLComputePipelineState>> psos;
+    std::lock_guard<std::mutex> guard(lock);
+    auto it = psos.find((uintptr_t)(__bridge void *)device);
+    if (it != psos.end()) return it->second;
+    NSString *src = @"#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "struct R { float4 src; uint4 dst; };\n"
+        "kernel void lby_resample(texture2d<float, access::sample> s [[texture(0)]], texture2d<float, access::write> d [[texture(1)]],\n"
+        "                         constant R &r [[buffer(0)]], uint2 g [[thread_position_in_grid]]) {\n"
+        "    if (g.x >= r.dst.z || g.y >= r.dst.w) return;\n"
+        "    constexpr sampler smp(coord::pixel, address::clamp_to_edge, filter::linear);\n"
+        "    float2 p = r.src.xy + (float2(g) + 0.5f) * r.src.zw / float2(r.dst.zw);\n"
+        "    d.write(s.sample(smp, p), g + r.dst.xy);\n"
+        "}\n";
+    NSError *e = nil;
+    id<MTLLibrary> lib = [device newLibraryWithSource:src options:nil error:&e];
+    id<MTLFunction> fn = [lib newFunctionWithName:@"lby_resample"];
+    id<MTLComputePipelineState> pso = fn ? [device newComputePipelineStateWithFunction:fn error:&e] : nil;
+    if (pso) psos[(uintptr_t)(__bridge void *)device] = pso;
+    return pso;
+}
