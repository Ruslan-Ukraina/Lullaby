+// Patch 0006: frames generated at the size the game draws. D3DMetal stretches the game's picture (RE9: 2294x1290) to the
+// window (3024x1701) before frame generation, so ANR worked on pixels that carry no more detail than the game's; at the
+// game's size it costs about 40 % less (stand, M4 Pro: 3.3 ms against 5.4 ms). FSR4_ANR_SCALE=auto takes that size from
+// the game's MetalFX temporal scaler when its shape matches; a number (0.5 .. 1) scales the picture by it.
+extern "C" volatile uint32_t lby_upscale_out_w, lby_upscale_out_h;
+static void anrScaledSize(NSUInteger w, NSUInteger h, NSUInteger *gw, NSUInteger *gh) {
+    *gw = w; *gh = h;
+    const char *e = getenv("FSR4_ANR_SCALE");
+    if (!e || !*e || !strcmp(e, "1") || !strcmp(e, "off")) return;
+    if (!strcmp(e, "auto")) {
+        const NSUInteger uw = lby_upscale_out_w, uh = lby_upscale_out_h;
+        if (uw >= 256 && uh >= 144 && uw < w && uh < h && fabs(double(uw) / uh - double(w) / h) < 0.01 * double(w) / h) {
+            *gw = uw; *gh = uh;
+        }
+        return;
+    }
+    const double f = atof(e);
+    if (f >= 0.5 && f < 1.0) { *gw = NSUInteger(w * f + 0.5) & ~NSUInteger(1); *gh = NSUInteger(h * f + 0.5) & ~NSUInteger(1); }
+}
