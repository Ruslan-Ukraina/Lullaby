+// Lullaby (patch 0012): frames for looking at ANR's output. Writing "dump=N" into $FSR4_ROOT/dist/crossover/anr-dump.conf
+// copies N frames' generated picture and the game's picture it was made from (both at ANR's size, the texture format
+// as is) into $FSR4_ROOT/dumps/anr-<time>/NNN-gen.raw / NNN-color.raw, with meta.txt. One frame in flight at a time.
+static std::atomic<int> g_dumpLeft{0};
+static std::string g_dumpDir;
+static void lbyDumpCheck() {
+    static double last = 0; static time_t seen = 0;
+    const double now = CFAbsoluteTimeGetCurrent();
+    if (now - last < 1.0) return;
+    last = now;
+    const char *root = getenv("FSR4_ROOT"); if (!root || !*root) return;
+    const std::string path = std::string(root) + "/dist/crossover/anr-dump.conf";
+    struct stat st; if (stat(path.c_str(), &st) || st.st_mtime == seen) return;
+    seen = st.st_mtime;
+    int n = 0; if (FILE *f = fopen(path.c_str(), "r")) { if (fscanf(f, "dump=%d", &n) != 1) n = 0; fclose(f); }
+    if (n <= 0) return;
+    char dir[64]; time_t tt = time(nullptr); strftime(dir, sizeof dir, "anr-%Y%m%d-%H%M%S", localtime(&tt));
+    g_dumpDir = std::string(root) + "/dumps/" + dir;
+    [[NSFileManager defaultManager] createDirectoryAtPath:@(g_dumpDir.c_str()) withIntermediateDirectories:YES attributes:nil error:nil];
+    g_dumpLeft.store(std::min(n, 60));
+    logHook(("ANR dump of " + std::to_string(n) + " frames into " + g_dumpDir).c_str(), Nil);
+}
+static void lbyDumpWrite(LbyAnrSubrect *sr) {   // the copies of a frame at least three frames back are done
+    if (!sr->dumpPending || sr->frame - sr->dumpPending < 3) return;
+    const size_t n = sr->gw * sr->gh * 4;
+    char p[64];
+    snprintf(p, sizeof p, "/%03u-gen.raw", sr->dumpFrame);
+    if (FILE *f = fopen((g_dumpDir + p).c_str(), "wb")) { fwrite(sr->dumpBuf[0].contents, 1, n, f); fclose(f); }
+    snprintf(p, sizeof p, "/%03u-color.raw", sr->dumpFrame);
+    if (FILE *f = fopen((g_dumpDir + p).c_str(), "wb")) { fwrite(sr->dumpBuf[1].contents, 1, n, f); fclose(f); }
+    if (FILE *f = fopen((g_dumpDir + "/meta.txt").c_str(), "a")) {
+        fprintf(f, "frame=%u size=%lux%lu format=%lu\n", sr->dumpFrame, (unsigned long)sr->gw, (unsigned long)sr->gh,
+                (unsigned long)sr->colorFormat);
+        fclose(f);
+    }
+    sr->dumpPending = 0;
+}
