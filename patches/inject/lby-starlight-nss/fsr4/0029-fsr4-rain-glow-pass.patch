+// Lullaby (patch 0029): rain that falls on the same lines. A drop lights a point for one frame in five or so; FSR 4
+// averages those flashes into a steady glowing line that grows while the camera stands still (RE9: 0.2 in the game's
+// frame, 5-10 in FSR 4's output on the drop lines). After FSR 4, per render pixel: its usual level (flashes left out)
+// and how often it flashes; where it flashes often, FSR 4's output is kept no brighter than the game's current frame
+// (softened 3x3). It only darkens, only there. FSR4_RAIN=1 (Lullaby: LULLABY_RAIN) or rain=on|off in
+// $FSR4_ROOT/dist/crossover/fsr4-live.conf (read about once a second). Metal 4 command buffers only.
+@interface LbyRainState : NSObject { @public id<MTLTexture> base, freq, copy; id<MTLResidencySet> res;
+    id<MTL4ArgumentTable> t1, t2; id<MTLBuffer> k; NSUInteger rw, rh; } @end
+@implementation LbyRainState @end
+static const void *kRainAssoc = &kRainAssoc;
+static int lby_rain_on(void) {
+    static int env = -1, live = -1; static double last = 0; static time_t seen = 0;
+    if (env < 0) { const char *e = getenv("FSR4_RAIN"); env = e && e[0] == '1'; }
+    const double now = CFAbsoluteTimeGetCurrent();
+    if (now - last > 1.0) {
+        last = now;
+        const char *root = getenv("FSR4_ROOT");
+        if (root) {
+            char p[1024]; snprintf(p, sizeof p, "%s/dist/crossover/fsr4-live.conf", root);
+            struct stat st;
+            if (!stat(p, &st) && st.st_mtime != seen) {
+                seen = st.st_mtime; live = -1;
+                FILE *f = fopen(p, "r"); char line[128];
+                while (f && fgets(line, sizeof line, f)) {
+                    if (!strncmp(line, "rain=on", 7)) live = 1;
+                    if (!strncmp(line, "rain=off", 8)) live = 0;
+                }
+                if (f) fclose(f);
+                hook_log("fsr4-live.conf: rain %s", live < 0 ? "as launched" : live ? "on" : "off");
+            } else if (stat(p, &st)) live = -1;
+        }
+    }
+    return live >= 0 ? live : env;
+}
+static id<MTLComputePipelineState> g_rainUpdate, g_rainApply; static int g_rainState;   // 0 none, 1 compiling, 2 ready, 3 failed
+static void lby_rain_compile(id<MTLDevice> dev) {
+    if (g_rainState) return;
+    g_rainState = 1;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSString *src = @"#include <metal_stdlib>\n using namespace metal;\n"
+            "static float lum(float3 c) { c = max(c, 0.0f); return dot(c / (1.0f + c), float3(0.2126f, 0.7152f, 0.0722f)); }\n"
+            "kernel void lby_rain_update(texture2d<float, access::read> col [[texture(0)]], texture2d<float, access::read_write> base [[texture(1)]],\n"
+            "  texture2d<float, access::read_write> freq [[texture(2)]], constant uint4 &k [[buffer(0)]], uint2 g [[thread_position_in_grid]]) {\n"
+            "  if (g.x >= k.x || g.y >= k.y) return;\n"
+            "  const float l = lum(col.read(g).rgb); const float b = base.read(g).x; const bool first = k.z != 0;\n"
+            "  const bool flash = !first && l - b > 0.35f;\n"
+            "  freq.write(float4(first ? 0.0f : 0.92f * freq.read(g).x + (flash ? 0.08f : 0.0f)), g);\n"
+            "  base.write(float4(first ? l : (flash ? b : 0.9f * b + 0.1f * l)), g);\n"
+            "}\n"
+            "kernel void lby_rain_apply(texture2d<float, access::read> src [[texture(0)]], texture2d<float, access::write> dst [[texture(1)]],\n"
+            "  texture2d<float, access::read> col [[texture(2)]], texture2d<float, access::read> freq [[texture(3)]], constant uint4 &k [[buffer(0)]],\n"
+            "  uint2 g [[thread_position_in_grid]]) {\n"
+            "  const uint uw = dst.get_width(), uh = dst.get_height(); if (g.x >= uw || g.y >= uh) return;\n"
+            "  const int2 r = int2((float2(g) + 0.5f) * float2(k.xy) / float2(uw, uh));\n"
+            "  float f = 0.0f; float3 c = 0.0f;\n"
+            "  for (int dy = -1; dy <= 1; ++dy) for (int dx = -1; dx <= 1; ++dx) {\n"
+            "    const uint2 p = uint2(clamp(r + int2(dx, dy), int2(0), int2(k.x - 1, k.y - 1)));\n"
+            "    f = max(f, freq.read(p).x); c += col.read(p).rgb; }\n"
+            "  const float4 o = src.read(g); const float w = clamp(f * 8.0f, 0.0f, 1.0f);\n"
+            "  if (w <= 0.0f) { dst.write(o, g); return; }\n"
+            "  dst.write(float4(mix(o.rgb, min(o.rgb, c / 9.0f), w), o.a), g);\n"
+            "}\n";
+        NSError *e = nil;
+        id<MTLLibrary> lib = [dev newLibraryWithSource:src options:nil error:&e];
+        id<MTLComputePipelineState> a = lib ? [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"lby_rain_update"] error:&e] : nil;
+        id<MTLComputePipelineState> b = lib ? [dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"lby_rain_apply"] error:&e] : nil;
+        if (a && b) { g_rainUpdate = a; g_rainApply = b; g_rainState = 2; hook_log("rain pass ready"); }
+        else { g_rainState = 3; hook_log("rain pass: kernels unavailable (%s)", e ? e.localizedDescription.UTF8String : "?"); }
+    });
+}
+static id<MTLTexture> lby_rain_tex(id<MTLDevice> d, MTLPixelFormat f, NSUInteger w, NSUInteger h) {
+    MTLTextureDescriptor *t = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:f width:w height:h mipmapped:NO];
+    t.storageMode = MTLStorageModePrivate; t.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+    return [d newTextureWithDescriptor:t];
+}
+static void lby_rain_pass(id scaler, id commandBuffer, Fsr4OwnerLifetime *lifetime) {
+    if (!lby_rain_on()) return;
+    if (![commandBuffer respondsToSelector:@selector(useResidencySet:)] || [commandBuffer respondsToSelector:@selector(addCompletedHandler:)]) return;
+    id<MTLFXTemporalScaler> s = scaler;
+    id<MTLTexture> color = s.colorTexture, output = s.outputTexture;
+    id<MTLDevice> dev = color.device;
+    if (!color || !output || !dev) return;
+    if (optional_offset(scaler, lifetime, 0) || optional_offset(scaler, lifetime, 1) || optional_offset(scaler, lifetime, 6)
+        || optional_offset(scaler, lifetime, 7)) return;   // content offsets: not handled here
+    lby_rain_compile(dev);
+    if (g_rainState != 2) return;
+    NSUInteger rw = s.inputContentWidth, rh = s.inputContentHeight;
+    if (!rw && !rh) { rw = s.inputWidth; rh = s.inputHeight; }
+    LbyRainState *st = objc_getAssociatedObject(scaler, kRainAssoc);
+    bool first = false;
+    if (!st || st->rw != rw || st->rh != rh || st->copy.pixelFormat != output.pixelFormat || st->copy.width != output.width
+        || st->copy.height != output.height) {
+        st = [LbyRainState new]; st->rw = rw; st->rh = rh; first = true;
+        st->base = lby_rain_tex(dev, MTLPixelFormatR16Float, rw, rh); st->freq = lby_rain_tex(dev, MTLPixelFormatR16Float, rw, rh);
+        st->copy = lby_rain_tex(dev, output.pixelFormat, output.width, output.height);
+        st->k = [dev newBufferWithLength:32 options:MTLResourceStorageModeShared];
+        MTL4ArgumentTableDescriptor *td = [MTL4ArgumentTableDescriptor new]; td.maxBufferBindCount = 1; td.maxTextureBindCount = 4;
+        st->t1 = [dev newArgumentTableWithDescriptor:td error:nil]; st->t2 = [dev newArgumentTableWithDescriptor:td error:nil];
+        MTLResidencySetDescriptor *rd = [MTLResidencySetDescriptor new]; rd.label = @"lullaby rain";
+        st->res = [dev newResidencySetWithDescriptor:rd error:nil];
+        if (!st->base || !st->freq || !st->copy || !st->k || !st->t1 || !st->t2 || !st->res) return;
+        for (id<MTLAllocation> a in @[st->base, st->freq, st->copy, st->k]) [st->res addAllocation:a];
+        [st->res commit];
+        objc_setAssociatedObject(scaler, kRainAssoc, st, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        hook_log("rain pass on: %lux%lu -> %lux%lu, output format %lu", (unsigned long)rw, (unsigned long)rh,
+                 (unsigned long)output.width, (unsigned long)output.height, (unsigned long)output.pixelFormat);
+    }
+    uint32_t *k = (uint32_t *)st->k.contents; k[0] = (uint32_t)rw; k[1] = (uint32_t)rh; k[2] = (first || s.reset) ? 1 : 0; k[3] = 0;
+    id<MTL4CommandBuffer> cb = commandBuffer;
+    [cb useResidencySet:st->res];
+    id<MTLFence> fence = lifetime->hasFence ? s.fence : nil;
+    id<MTL4ComputeCommandEncoder> enc = [cb computeCommandEncoder];
+    if (!enc) return;
+    [enc barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageDispatch | MTLStageBlit visibilityOptions:MTL4VisibilityOptionDevice];
+    if (fence) [enc waitForFence:fence beforeEncoderStages:MTLStageDispatch | MTLStageBlit];
+    [enc copyFromTexture:output toTexture:st->copy];
+    [enc setComputePipelineState:g_rainUpdate];
+    [st->t1 setTexture:color.gpuResourceID atIndex:0]; [st->t1 setTexture:st->base.gpuResourceID atIndex:1];
+    [st->t1 setTexture:st->freq.gpuResourceID atIndex:2]; [st->t1 setAddress:st->k.gpuAddress atIndex:0];
+    [enc setArgumentTable:st->t1];
+    [enc dispatchThreads:MTLSizeMake(rw, rh, 1) threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];
+    [enc barrierAfterEncoderStages:MTLStageDispatch | MTLStageBlit beforeEncoderStages:MTLStageDispatch visibilityOptions:MTL4VisibilityOptionDevice];
+    [enc setComputePipelineState:g_rainApply];
+    [st->t2 setTexture:st->copy.gpuResourceID atIndex:0]; [st->t2 setTexture:output.gpuResourceID atIndex:1];
+    [st->t2 setTexture:color.gpuResourceID atIndex:2]; [st->t2 setTexture:st->freq.gpuResourceID atIndex:3];
+    [st->t2 setAddress:st->k.gpuAddress atIndex:0];
+    [enc setArgumentTable:st->t2];
+    [enc dispatchThreads:MTLSizeMake(output.width, output.height, 1) threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];
+    [enc barrierAfterEncoderStages:MTLStageDispatch beforeEncoderStages:MTLStageDispatch | MTLStageBlit visibilityOptions:MTL4VisibilityOptionDevice];
+    if (fence) [enc updateFence:fence afterEncoderStages:MTLStageDispatch];
+    [enc endEncoding];
+}
