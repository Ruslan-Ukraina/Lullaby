+// Patch 0030: detail from the real frame. ANR made at a smaller size (cheaper) is stretched back; the stretch adds the
+// game's current frame's fine detail (its picture minus that picture taken down to ANR's size) from where the point is
+// in the current frame (half a frame of motion away), weighted by how well ANR's frame and the current one agree there,
+// and never on the interface. FSR4_ANR_DETAIL=<0..1> or anrdetail=<0..1> in anr3x.conf (live).
+static float lbyAnrDetail() {
+    const float live = fsr4_anr_live_detail();
+    if (live >= 0) return live;
+    static const float env = getenv("FSR4_ANR_DETAIL") ? (float)atof(getenv("FSR4_ANR_DETAIL")) : 0.f;
+    return env;
+}
+static id<MTLComputePipelineState> detailPSO(id<MTLDevice> device) {
+    static std::mutex lock; static id<MTLComputePipelineState> pso; static bool pending = false, failed = false;
+    std::lock_guard<std::mutex> guard(lock);
+    if (pso || pending || failed) return pso;
+    pending = true;
+    id<MTLDevice> dev = device;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSString *src = @"#include <metal_stdlib>\n using namespace metal;\n"
+            "struct P { float4 pic; float2 mvScale; float k, t; uint hasUI, r0, r1, r2; };\n"
+            "static float lum(float3 c) { return dot(c, float3(0.2126f, 0.7152f, 0.0722f)); }\n"
+            "kernel void lby_up_detail(texture2d<float, access::sample> gen [[texture(0)]], texture2d<float, access::sample> curd [[texture(1)]],\n"
+            "  texture2d<float, access::read> cur [[texture(2)]], texture2d<float, access::sample> mv [[texture(3)]],\n"
+            "  texture2d<float, access::write> out [[texture(4)]], texture2d<float, access::read> ui [[texture(5)]],\n"
+            "  constant P &p [[buffer(0)]], uint2 g [[thread_position_in_grid]]) {\n"
+            "  const uint w = uint(p.pic.z), h = uint(p.pic.w); if (g.x >= w || g.y >= h) return;\n"
+            "  constexpr sampler lin(coord::normalized, address::clamp_to_edge, filter::linear);\n"
+            "  constexpr sampler pt(coord::normalized, address::clamp_to_edge, filter::nearest);\n"
+            "  const float2 size = float2(w, h), uv = (float2(g) + 0.5f) / size;\n"
+            "  const uint2 o = uint2(p.pic.xy) + g;\n"
+            "  const float4 G = gen.sample(lin, uv);\n"
+            "  float wgt = p.k;\n"
+            "  if (p.hasUI != 0 && ui.read(o).a > 0.004f) wgt = 0.0f;\n"
+            "  if (wgt > 0.0f) {\n"
+            "    const float2 m = mv.sample(pt, uv).xy * p.mvScale / float2(mv.get_width(), mv.get_height());\n"
+            "    const float2 q = uv - 0.5f * m;\n"
+            "    if (any(q < 0.0f) || any(q > 1.0f)) wgt = 0.0f;\n"
+            "    else {\n"
+            "      const uint2 qp = uint2(p.pic.xy) + uint2(clamp(q * size, float2(0), size - 1.0f));\n"
+            "      if (p.hasUI != 0 && ui.read(qp).a > 0.004f) wgt = 0.0f;\n"
+            "      const float4 low = curd.sample(lin, q);\n"
+            "      const float agree = fabs(lum(G.rgb) - lum(low.rgb));\n"
+            "      wgt *= saturate(1.0f - agree / p.t);\n"
+            "      if (wgt > 0.0f) { out.write(float4(max(G.rgb + (cur.read(qp).rgb - low.rgb) * wgt, 0.0f), G.a), o); return; }\n"
+            "    }\n"
+            "  }\n"
+            "  out.write(G, o);\n"
+            "}\n";
+        NSError *e = nil;
+        id<MTLLibrary> lib = [dev newLibraryWithSource:src options:nil error:&e];
+        id<MTLFunction> fn = [lib newFunctionWithName:@"lby_up_detail"];
+        id<MTLComputePipelineState> p = fn ? [dev newComputePipelineStateWithFunction:fn error:&e] : nil;
+        std::lock_guard<std::mutex> g2(lock);
+        pso = p; pending = false; failed = p == nil;
+        logHook(p ? "ANR detail from the real frame ready" : "ANR detail: kernel unavailable", Nil);
+    });
+    return nil;
+}
