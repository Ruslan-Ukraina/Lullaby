 // encoding bits 0..1: 0=linear HDR, 1=SDR code, 2=PQ10 code.
 // encoding bit 3 (8): V.B20 native passthrough (skip color transfer conversion).
+// Lullaby (patch 0007): depth and motion for a generated-frame pixel. Bit 0 of `flags` is the depth direction (1:
+// reversed, near = 1); with bit 1 the motion comes from the nearest-to-camera of the 3x3 render pixels around it (and so
+// does the depth), as FSR's own preparation dilates them: at a character's outline the background no longer gets the
+// character's motion or the other way round, which showed as a halo around the character in motion.
+inline void lby_depth_motion(texture2d<float,access::read> depth,texture2d<float,access::read> motion,uint2 low,uint2 size,
+                             uint flags,thread float &z,thread float2 &mv) {
+    const bool rev=(flags&1u)!=0u;
+    uint2 pick=low;
+    z=depth.read(low).x;
+    if((flags&2u)!=0u){
+        float best=isfinite(z)?z:(rev?-1e30f:1e30f);
+        for(int dy=-1;dy<=1;++dy)for(int dx=-1;dx<=1;++dx){
+            if(!dx&&!dy)continue;
+            const uint2 q=uint2(clamp(int2(low)+int2(dx,dy),int2(0),int2(size)-1));
+            const float d=depth.read(q).x;
+            if(isfinite(d)&&(rev?d>best:d<best)){best=d;pick=q;}
+        }
+        z=depth.read(pick).x;
+    }
+    if(!isfinite(z))z=rev?0:1;
+    mv=motion.read(pick).xy;mv=select(mv,float2(0),!isfinite(mv));
+}
