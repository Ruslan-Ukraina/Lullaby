+/// Lullaby: the temporal step's tuning for every upscaler (neutral 0, 1, 1, 1): added to and multiplying the new frame's weight,
+/// multiplying the history clamp's width and how much history may bypass the clamp.
+FOUNDATION_EXPORT void NSSSetTemporalTuning(float alphaAdd, float alphaMul, float gammaMul, float thetaMul);
+/// Lullaby: history bypasses the clamp only where it can be trusted (0 = everywhere, as shipped): it is gone at this much
+/// motion (output px) and when history lies this many clamp widths outside the current neighbourhood.
+FOUNDATION_EXPORT void NSSSetHistoryTrust(float thetaMotionPx, float thetaDev);
+/// Lullaby: where nothing moves, history bypasses the clamp only while it lies within this many clamp widths of the
+/// current neighbourhood (0 = always, as shipped): a raindrop or spark that was there one frame is not kept.
+FOUNDATION_EXPORT void NSSSetHistoryTrustStill(float thetaDevStill);
+/// Lullaby: a lone pixel more than k spreads off its neighbours' mean, while the history agrees with them, takes up to
+/// `strength` less of the new frame (dithered hair and other per-frame noise average out). 0, 0 = off.
+FOUNDATION_EXPORT void NSSSetOutlierDamping(float k, float strength);
+/// Lullaby: history that is a lone spot (no line through it) more than `dev` clamp widths off this frame's neighbourhood
+/// does not bypass the clamp (old raindrops, sparks); lines keep it. 0 = off.
+FOUNDATION_EXPORT void NSSSetSparkHistory(float dev);
+/// Lullaby: the still-area agreement check (NSSSetHistoryTrustStill) applies only where this frame is flat around the
+/// pixel (local spread / mean below `flat`); 0 = everywhere.
+FOUNDATION_EXPORT void NSSSetStillFlatness(float flat);
