-/* On the game's thread, before the stream's own work: has the default output device changed since this stream looked? */
+/* The same for a capture stream: a new unit and converter for the new microphone, and the ring of captured frames starts empty
+ * (its frames are the old device's, at its rate). */
+static void follow_capture_device(struct coreaudio_stream *stream, AudioDeviceID new_id)
+{
+    AudioComponentInstance unit, old_unit;
+    AudioStreamBasicDescription desc;
+    AudioConverterRef converter = NULL, old_converter;
+    AURenderCallbackStruct input;
+    unsigned int min_frames, max_frames;
+    UINT32 cap_frames;
+    BYTE *cap_buffer, *old_cap_buffer;
+    OSStatus sc;
+
+    TRACE("stream %p: input device %u -> %u\n", stream, (unsigned int)stream->dev_id, (unsigned int)new_id);
+
+    if(SUCCEEDED(get_device_period_frame_range(new_id, eCapture, &min_frames, &max_frames)))
+        request_device_period_frame_size(new_id, eCapture,
+                                         max(min_frames, min(stream->period_frames, max_frames)));
+
+    if(!(unit = get_audiounit(eCapture, new_id))){
+        WARN("Couldn't make an audio unit for device %u, the stream stays where it is\n", (unsigned int)new_id);
+        return;
+    }
+    if(FAILED(ca_setup_audiounit(eCapture, unit, stream->fmt, &desc, &converter))){
+        WARN("Couldn't set the stream's format on device %u\n", (unsigned int)new_id);
+        AudioComponentInstanceDispose(unit);
+        return;
+    }
+    input.inputProc = ca_capture_cb;
+    input.inputProcRefCon = stream;
+    sc = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_SetInputCallback, kAudioUnitScope_Output, 1, &input, sizeof(input));
+    if(sc == noErr) sc = AudioUnitInitialize(unit);
+    cap_frames = muldiv(stream->bufsize_frames, desc.mSampleRate, stream->fmt->nSamplesPerSec);
+    cap_buffer = cap_frames ? malloc(cap_frames * stream->fmt->nBlockAlign) : NULL;
+    if(sc != noErr || !cap_buffer){
+        WARN("Couldn't start capture on device %u: %x\n", (unsigned int)new_id, (int)sc);
+        free(cap_buffer);
+        AudioConverterDispose(converter);
+        AudioComponentInstanceDispose(unit);
+        return;
+    }
+
+    old_unit = stream->unit;
+    AudioOutputUnitStop(old_unit);
+    os_unfair_lock_lock(&stream->lock);
+    old_converter = stream->converter;
+    old_cap_buffer = stream->cap_buffer;
+    stream->unit = unit;
+    stream->converter = converter;
+    stream->cap_buffer = cap_buffer;
+    stream->cap_bufsize_frames = cap_frames;
+    stream->cap_offs_frames = stream->cap_held_frames = 0;
+    stream->dev_id = new_id;
+    stream->dev_desc = desc;
+    os_unfair_lock_unlock(&stream->lock);
+    sc = AudioOutputUnitStart(unit);
+    if(sc != noErr) WARN("Unit failed to start on device %u: %x\n", (unsigned int)new_id, (int)sc);
+    AudioComponentInstanceDispose(old_unit);
+    if(old_converter) AudioConverterDispose(old_converter);
+    free(old_cap_buffer);
+}
