+
+/* A render stream opened on the default output device goes with it. Without this a game that has no choice of device keeps
+ * playing on the speakers after headphones are plugged in (Windows moves such streams itself). One listener counts the changes
+ * of the default output device and does nothing else: a question to CoreAudio from the thread it runs on is never answered in
+ * some processes (a game that takes the device first on a change), so the stream itself notices the count at its next call from
+ * the game (or the timer thread) and moves on the game's own thread, as it was made. LULLABY_AUDIO_FOLLOW=0 turns it off. */
+static int default_output_changes;
+
+static AudioDeviceID default_output_device(void)
+{
+    AudioDeviceID id = kAudioObjectUnknown;
+    UInt32 size = sizeof(id);
+    const AudioObjectPropertyAddress addr =
+    {
+        .mScope = kAudioObjectPropertyScopeGlobal,
+        .mElement = kAudioObjectPropertyElementMain,
+        .mSelector = kAudioHardwarePropertyDefaultOutputDevice,
+    };
+
+    if(AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &id) != noErr)
+        return kAudioObjectUnknown;
+    return id;
 }
 
+/* A new unit is made the way the stream's first one was, and only then does it take the old one's place. */
+static void follow_default_device(struct coreaudio_stream *stream, AudioDeviceID new_id)
+{
+    AudioComponentInstance unit, old_unit;
+    AudioStreamBasicDescription desc;
+    AudioConverterRef unused = NULL;
+    AURenderCallbackStruct input;
+    unsigned int min_frames, max_frames;
+    OSStatus sc;
+
+    TRACE("stream %p: output device %u -> %u\n", stream, (unsigned int)stream->dev_id, (unsigned int)new_id);
+
+    if(SUCCEEDED(get_device_period_frame_range(new_id, eRender, &min_frames, &max_frames)))
+        request_device_period_frame_size(new_id, eRender,
+                                         max(min_frames, min(stream->period_frames, max_frames)));
+
+    if(!(unit = get_audiounit(eRender, new_id))){
+        WARN("Couldn't make an audio unit for device %u, the stream stays where it is\n", (unsigned int)new_id);
+        return;
+    }
+    if(FAILED(ca_setup_audiounit(eRender, unit, stream->fmt, &desc, &unused))){
+        WARN("Couldn't set the stream's format on device %u\n", (unsigned int)new_id);
+        AudioComponentInstanceDispose(unit);
+        return;
+    }
+    input.inputProc = ca_render_cb;
+    input.inputProcRefCon = stream;
+    AudioUnitSetProperty(unit, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input, 0, &input, sizeof(input));
+    sc = AudioUnitInitialize(unit);
+    if(sc != noErr){
+        WARN("Couldn't initialize the unit for device %u: %x\n", (unsigned int)new_id, (int)sc);
+        AudioComponentInstanceDispose(unit);
+        return;
+    }
+
+    /* the old unit stops first, so that two units do not take the same frames from the buffer */
+    old_unit = stream->unit;
+    AudioOutputUnitStop(old_unit);
+    os_unfair_lock_lock(&stream->lock);
+    stream->unit = unit;
+    stream->dev_id = new_id;
+    stream->dev_desc = desc;
+    os_unfair_lock_unlock(&stream->lock);
+    sc = AudioOutputUnitStart(unit);
+    if(sc != noErr) WARN("Unit failed to start on device %u: %x\n", (unsigned int)new_id, (int)sc);
+    AudioComponentInstanceDispose(old_unit);
+}
+
+/* On the game's thread, before the stream's own work: has the default output device changed since this stream looked? */
+static void follow_check(struct coreaudio_stream *stream)
+{
+    AudioDeviceID id;
+    int changes;
+
+    if(!stream->follow_default) return;
+    changes = __atomic_load_n(&default_output_changes, __ATOMIC_SEQ_CST);
+    if(changes == stream->seen_changes) return;
+    if(__atomic_exchange_n(&stream->moving, 1, __ATOMIC_SEQ_CST)) return;   /* another thread is on it */
+
+    stream->seen_changes = changes;
+    id = default_output_device();
+    if(id != kAudioObjectUnknown && id != stream->dev_id)
+        follow_default_device(stream, id);
+    __atomic_store_n(&stream->moving, 0, __ATOMIC_SEQ_CST);
+}
+
+static void install_default_listener(void)
+{
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        static const AudioObjectPropertyAddress addr =
+        {
+            .mScope = kAudioObjectPropertyScopeGlobal,
+            .mElement = kAudioObjectPropertyElementMain,
+            .mSelector = kAudioHardwarePropertyDefaultOutputDevice,
+        };
+        dispatch_queue_t queue = dispatch_queue_create("org.winehq.coreaudio.default-output", DISPATCH_QUEUE_SERIAL);
+        OSStatus sc = AudioObjectAddPropertyListenerBlock(kAudioObjectSystemObject, &addr, queue,
+                                                          ^(UInt32 count, const AudioObjectPropertyAddress *addrs){
+                                                              __atomic_add_fetch(&default_output_changes, 1, __ATOMIC_SEQ_CST);
+                                                          });
+        if(sc != noErr) WARN("Couldn't listen for a change of the default output device: %x\n", (int)sc);
+    });
+}
+
+static void follow_default_add(struct coreaudio_stream *stream)
+{
+    const char *off = getenv("LULLABY_AUDIO_FOLLOW");
+
+    if((off && !strcmp(off, "0")) || stream->flow != eRender || stream->dev_id == kAudioObjectUnknown ||
+       stream->dev_id != default_output_device())
+        return;
+
+    install_default_listener();
+    stream->seen_changes = __atomic_load_n(&default_output_changes, __ATOMIC_SEQ_CST);
+    stream->follow_default = TRUE;
+    TRACE("stream %p (device %u, %u ch, %u Hz) follows the default output\n", stream,
+          (unsigned int)stream->dev_id, stream->fmt->nChannels, (unsigned int)stream->fmt->nSamplesPerSec);
+}
