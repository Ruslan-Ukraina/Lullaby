+
+    - (void) setDisplaySyncEnabled:(BOOL)enabled
+    {
+        lullaby_layer_switches();
+        [super setDisplaySyncEnabled:lullaby_force_vsync ? YES : enabled];
+        if (lullaby_force_vsync && self.maximumDrawableCount < 3) [super setMaximumDrawableCount:3];
+    }
+
+    /* With the layer in step with the display a frame waits for a refresh before its
+       drawable comes back, so two drawables leave the GPU waiting for one: with
+       LULLABY_FORCE_VSYNC the layer keeps at least three. The count D3DMetal asked for
+       goes to the log once. */
+    - (void) setMaximumDrawableCount:(NSUInteger)count
+    {
+        static int logged;
+        lullaby_layer_switches();
+        if (!logged++)
+            fprintf(stderr, "lullaby: D3DMetal layer: %lu drawables asked for%s\n", (unsigned long)count,
+                    lullaby_force_vsync && count < 3 ? ", 3 given (force vsync)" : "");
+        [super setMaximumDrawableCount:lullaby_force_vsync && count < 3 ? 3 : count];
+    }
+
