+static BOOL fullscreen_size_reported(void)
+{
+    const char *value = getenv("LULLABY_FULLSCREEN_SIZE");
+    return !value || strcmp(value, "0") != 0;
+}
+
+/* A window smaller than the screen that goes to native full screen keeps the size its program gave it, and the stage
+   scales it up (a game at 1920x1200 on a bigger screen). A window that covered the screen is told the new size (ENG-12).
+   The flag lives with the window until it leaves full screen. LULLABY_FULLSCREEN_SCALE=0 turns this off. */
+#import <objc/runtime.h>
+
+static const char fullscreen_scaled_key;
+
+static BOOL fullscreen_scaled(NSWindow *window)
+{
+    return objc_getAssociatedObject(window, &fullscreen_scaled_key) != nil;
+}
+
+/* The size of the program's client area before full screen, kept with the flag: the title bar is gone in full screen,
+   and a content size worked out from the frame then would be that much too tall. */
+static void set_fullscreen_scaled(NSWindow *window, BOOL on, NSSize content)
+{
+    objc_setAssociatedObject(window, &fullscreen_scaled_key, on ? [NSValue valueWithSize:content] : nil,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+static NSSize fullscreen_scaled_content(NSWindow *window)
+{
+    return [(NSValue *)objc_getAssociatedObject(window, &fullscreen_scaled_key) sizeValue];
+}
+
+static BOOL fullscreen_scale_enabled(void)
+{
+    const char *value = getenv("LULLABY_FULLSCREEN_SCALE");
+    return fullscreen_size_reported() && (!value || strcmp(value, "0") != 0);
+}
+
+static BOOL frame_covers_screen(NSRect frame, NSScreen *screen)
+{
+    NSRect screen_frame = [screen frame];
+    return frame.size.width >= screen_frame.size.width - 2 && frame.size.height >= screen_frame.size.height - 40;
+}
