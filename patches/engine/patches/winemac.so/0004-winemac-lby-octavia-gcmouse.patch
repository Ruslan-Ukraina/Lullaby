+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#import <AppKit/AppKit.h>
+/* The header only declares GameController's types; the framework is not linked (that would need a line in
+   Makefile.in) but loaded when the first mouse is looked for. The notification names are the framework's
+   own strings. */
+#import <GameController/GameController.h>
+#import <IOKit/IOKitLib.h>
+#include <time.h>
+
+#include "macdrv_cocoa.h"
+#import "cocoa_app.h"
+#import "cocoa_event.h"
+#import "cocoa_window.h"
+
+#pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
+#pragma GCC diagnostic ignored "-Wunguarded-availability-new"
+
+
+/* Lullaby, 2026-10: no change to the build files (this file is included at the end of cocoa_event.m), a trackpad
+   or any pointer GameController does not move keeps the engine's own path, and the raw counts are scaled by the
+   mouse's resolution. */
+
+static NSMutableSet *configured_mice;
+static dispatch_queue_t gcmouse_queue;
+static BOOL observing_mice;
+/* When GameController last delivered movement (CLOCK_UPTIME_RAW, ns). AppKit's mouse-moved events for the same
+   movement arrive a few milliseconds later and are not sent a second time; movement GameController did not
+   report (a trackpad) is not recent, so those events go through as the engine always sent them. */
+static uint64_t gcmouse_last_move;
+#define GCMOUSE_RECENT_NS (40ull * 1000 * 1000)
+/* The scale applied to raw counts and the part of the movement not yet sent (the event holds whole numbers).
+   Both belong to the one GameController queue. */
+static double gcmouse_scale = 0.3;
+static double gcmouse_carry_x, gcmouse_carry_y;
+/* Counts per inch at which a 1:1 scale would feel as the engine's own path does; the owner's mouse was
+   calibrated at 0.3. scale = reference / counts-per-inch, within 0.05 .. 2. */
+#define GCMOUSE_REFERENCE_CPI 480.0
+#define GCMOUSE_DEFAULT_SCALE 0.3
+
+
+@interface WineApplicationController (GCMouseAccess)
+
+    - (WineWindow *) mouseCaptureWindow;
+
+@end
+
+
+@interface WineApplicationController (GCMouseNotifications)
+
+    - (void) gcmouseDidConnect:(NSNotification *)notification;
+    - (void) gcmouseDidDisconnect:(NSNotification *)notification;
+
+@end
+
+
+static uint64_t gcmouse_now(void)
+{
+    return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+
+static void post_mouse_movement(float delta_x, float delta_y)
+{
+    WineApplicationController *controller;
+    WineWindow *window;
+    macdrv_event *event;
+
+    if (!NSApp || (!delta_x && !delta_y)) return;
+
+    controller = [WineApplicationController sharedController];
+    window = [controller mouseCaptureWindow] ?: [controller frontWineWindow];
+    if (!window) return;
+
+    double sx = delta_x * gcmouse_scale + gcmouse_carry_x;
+    double sy = delta_y * gcmouse_scale + gcmouse_carry_y;
+    int ix = (int)sx, iy = (int)sy;
+
+    gcmouse_carry_x = sx - ix;
+    gcmouse_carry_y = sy - iy;
+    __atomic_store_n(&gcmouse_last_move, gcmouse_now(), __ATOMIC_RELAXED);
+    if (!ix && !iy) return;
+
+    event = macdrv_create_event(MOUSE_MOVED_RAW, window);
+    event->mouse_moved.x = ix;
+    event->mouse_moved.y = -iy;
+    event->mouse_moved.time_ms = [controller ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+    [window.queue postEvent:event];
+    macdrv_release_event(event);
+}
+
+
+static BOOL looks_like_trackpad(GCMouse *mouse)
+{
+    NSString *name = [mouse vendorName];
+    NSString *category = [mouse productCategory];
+    return (name && [name rangeOfString:@"trackpad" options:NSCaseInsensitiveSearch].location != NSNotFound) ||
+           (category && [category rangeOfString:@"trackpad" options:NSCaseInsensitiveSearch].location != NSNotFound);
+}
+
+
+static void configure_mouse(GCMouse *mouse)
+{
+    GCMouseInput *input;
+
+    if (!mouse || [configured_mice containsObject:mouse]) return;
+    if (looks_like_trackpad(mouse))
+    {
+        NSLog(@"gcmouse: leaving %@ to the engine's own path (a trackpad)", [mouse vendorName]);
+        return;
+    }
+
+    if (!(input = [mouse mouseInput])) return;
+
+    [mouse setHandlerQueue:gcmouse_queue];
+    [input setMouseMovedHandler:^(GCMouseInput *input, float delta_x, float delta_y) {
+        post_mouse_movement(delta_x, delta_y);
+    }];
+
+    [configured_mice addObject:mouse];
+    NSLog(@"gcmouse: reading %@, scale %.3f", [mouse vendorName], gcmouse_scale);
+}
+
+
+static void remove_mouse(GCMouse *mouse)
+{
+    if (!mouse || ![configured_mice containsObject:mouse]) return;
+
+    [[mouse mouseInput] setMouseMovedHandler:nil];
+    [configured_mice removeObject:mouse];
+}
+
+
+/* The counts per inch a connected external mouse reports (HIDPointerResolution, 16.16 fixed point), 0 when no
+   mouse says. The built-in trackpad and anything called a trackpad are not asked. GameController does not say
+   which of several mice it is talking to, so the first that answers is taken. 400 is what macOS fills in for a
+   device that does not know its resolution (the trackpad and a mouse such as the Hator Pulsar both say it), so it
+   counts as no answer. */
+static double external_mouse_cpi(void)
+{
+    io_iterator_t iterator = 0;
+    io_service_t service;
+    double cpi = 0;
+
+    if (IOServiceGetMatchingServices(0, IOServiceMatching("IOHIDDevice"), &iterator) != KERN_SUCCESS) return 0;
+    while (!cpi && (service = IOIteratorNext(iterator)))
+    {
+        CFTypeRef page = IORegistryEntryCreateCFProperty(service, CFSTR("PrimaryUsagePage"), kCFAllocatorDefault, 0);
+        CFTypeRef usage = IORegistryEntryCreateCFProperty(service, CFSTR("PrimaryUsage"), kCFAllocatorDefault, 0);
+        CFTypeRef builtin = IORegistryEntryCreateCFProperty(service, CFSTR("Built-In"), kCFAllocatorDefault, 0);
+        CFTypeRef product = IORegistryEntryCreateCFProperty(service, CFSTR("Product"), kCFAllocatorDefault, 0);
+        CFTypeRef resolution = IORegistryEntryCreateCFProperty(service, CFSTR("HIDPointerResolution"), kCFAllocatorDefault, 0);
+
+        if (page && usage && resolution && !(builtin && CFGetTypeID(builtin) == CFBooleanGetTypeID() && CFBooleanGetValue(builtin)) &&
+            CFGetTypeID(page) == CFNumberGetTypeID() && CFGetTypeID(usage) == CFNumberGetTypeID() &&
+            CFGetTypeID(resolution) == CFNumberGetTypeID())
+        {
+            int p = 0, u = 0;
+            long long r = 0;
+            CFNumberGetValue(page, kCFNumberIntType, &p);
+            CFNumberGetValue(usage, kCFNumberIntType, &u);
+            CFNumberGetValue(resolution, kCFNumberLongLongType, &r);
+            BOOL trackpad = product && CFGetTypeID(product) == CFStringGetTypeID() &&
+                CFStringFind(product, CFSTR("rackpad"), 0).location != kCFNotFound;
+            double value = r / 65536.0;
+            if (p == 1 && u == 2 && !trackpad && value >= 100 && value <= 30000 && fabs(value - 400) > 1) cpi = value;
+        }
+        if (page) CFRelease(page);
+        if (usage) CFRelease(usage);
+        if (builtin) CFRelease(builtin);
+        if (product) CFRelease(product);
+        if (resolution) CFRelease(resolution);
+        IOObjectRelease(service);
+    }
+    IOObjectRelease(iterator);
+    return cpi;
+}
+
+
+/* LULLABY_GCMOUSE_SCALE: a number is the scale (0.01 .. 100); anything else, or nothing, is automatic, from the
+   mouse's resolution when it says one and 0.3 when it does not. */
+static void choose_scale(void)
+{
+    const char *env = getenv("LULLABY_GCMOUSE_SCALE");
+    double value = env ? atof(env) : 0;
+
+    if (value > 0.01 && value < 100)
+    {
+        gcmouse_scale = value;
+        return;
+    }
+    double cpi = external_mouse_cpi();
+    if (cpi > 0)
+    {
+        gcmouse_scale = MIN(2.0, MAX(0.05, GCMOUSE_REFERENCE_CPI / cpi));
+        NSLog(@"gcmouse: the mouse reports %.0f counts per inch, scale %.3f", cpi, gcmouse_scale);
+    }
+    else gcmouse_scale = GCMOUSE_DEFAULT_SCALE;
+}
+
+
+static void start_gcmouse_input(void)
+{
+    NSNotificationCenter *center;
+    WineApplicationController *controller;
+    Class mouse_class;
+
+    if (!use_gcmouse) return;
+    if (observing_mice) return;
+
+    if (@available(macOS 14.0, *))
+    {
+        [[NSBundle bundleWithPath:@"/System/Library/Frameworks/GameController.framework"] load];
+        if (!(mouse_class = NSClassFromString(@"GCMouse"))) return;
+
+        center = [NSNotificationCenter defaultCenter];
+        controller = [WineApplicationController sharedController];
+        gcmouse_queue = dispatch_queue_create("org.winehq.GCMouse", DISPATCH_QUEUE_SERIAL);
+        if (!gcmouse_queue) return;
+        dispatch_set_target_queue(gcmouse_queue,
+                                  dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0));
+        configured_mice = [[NSMutableSet alloc] init];
+        choose_scale();
+        observing_mice = TRUE;
+
+        [center addObserver:controller selector:@selector(gcmouseDidConnect:)
+                       name:@"GCMouseDidConnectNotification" object:nil];
+        [center addObserver:controller selector:@selector(gcmouseDidDisconnect:)
+                       name:@"GCMouseDidDisconnectNotification" object:nil];
+
+        for (GCMouse *mouse in [mouse_class mice])
+            configure_mouse(mouse);
+    }
+}
+
+
+@implementation WineApplicationController (GCMouseNotifications)
+
+    - (void) gcmouseDidConnect:(NSNotification *)notification
+    {
+        configure_mouse([notification object]);
+    }
+
+    - (void) gcmouseDidDisconnect:(NSNotification *)notification
+    {
+        remove_mouse([notification object]);
+    }
+
+@end
+
+
+void macdrv_start_gcmouse_input(void)
+{
+    OnMainThreadAsync(^{ start_gcmouse_input(); });
+}
+
+
+/* Whether GameController is the source of the movement right now: AppKit's events for it are then left out. */
+bool macdrv_gcmouse_input_active(void)
+{
+    uint64_t last = __atomic_load_n(&gcmouse_last_move, __ATOMIC_RELAXED);
+    return last && gcmouse_now() - last < GCMOUSE_RECENT_NS;
+}
