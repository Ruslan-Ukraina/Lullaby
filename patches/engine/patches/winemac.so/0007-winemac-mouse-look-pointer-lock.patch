+    /* Mouse look: a game that hides the cursor and puts it back at the center
+       after every move (160+ times a second) made us warp the real cursor each
+       time. Every warp costs WindowServer work and throws away the mouse moves
+       queued until then, so with a 1000 Hz mouse aiming stuttered and felt
+       heavy (a controller was smooth). Instead, while the cursor is hidden and
+       we are active, detach the mouse from the cursor after the first warp and
+       send every move as a delta: Wine already has the position the game set.
+       The real cursor then stays where the game put it, so it never reaches
+       the Dock, the menu bar or a hot corner. LULLABY_MOUSELOOK=0 turns this
+       off. (Adapted from the mouse look patch of github.com/sirdankdabs/bo-mac,
+       MIT.) */
+    static BOOL mouselook_enabled(void)
+    {
+        static int enabled = -1;
+        if (enabled < 0)
+        {
+            const char *v = getenv("LULLABY_MOUSELOOK");
+            enabled = !(v && v[0] == '0');
+        }
+        return enabled;
+    }
+
+    - (void) endMouseLook
+    {
+        if (mouseLook)
+        {
+            mouseLook = FALSE;
+            CGAssociateMouseAndMouseCursorPosition(true);
+            forceNextMouseMoveAbsolute = TRUE;
+        }
+    }
+
     - (BOOL) setCursorPosition:(CGPoint)pos
     {
         BOOL ret;
 
+        /* Only the game putting the cursor back where it already is (its
+           recentring) is ignored. A game that moves the hidden cursor
+           elsewhere (a menu drawing its own pointer, say) gets the move, as
+           before: the look ends and starts again there. */
+        if (mouseLook && clientWantsCursorHidden && [NSApp isActive] && ![windowsBeingDragged count] &&
+            fabs(pos.x - mouseLookAnchor.x) < 2 && fabs(pos.y - mouseLookAnchor.y) < 2)
+            return TRUE;
+        [self endMouseLook];
+
         if ([windowsBeingDragged count])
             return FALSE;
 
@@ -2062,6 +2105,12 @@ - (BOOL) setCursorPosition:(CGPoint)pos
                 lastSetCursorPositionTime = [[NSProcessInfo processInfo] systemUptime];
 
                 CGAssociateMouseAndMouseCursorPosition(true);
+                if (mouselook_enabled() && clientWantsCursorHidden && [NSApp isActive])
+                {
+                    CGAssociateMouseAndMouseCursorPosition(false);
+                    mouseLook = TRUE;
+                    mouseLookAnchor = pos;
+                }
