+/* Lullaby: a game that asks for a display mode (Modern Warfare Remastered: 3024x1964 at 47 Hz) made the Mac switch the whole
+ * screen to a low-resolution mode, the desktop shrinking into a corner. The answer is "done", the display stays as it is.
+ * LULLABY_KEEP_DISPLAY_MODE=0 gives the old behaviour. */
+static BOOL keep_display_mode(void)
+{
+    const char *v = getenv("LULLABY_KEEP_DISPLAY_MODE");
+    return !(v && !strcmp(v, "0"));
+}
