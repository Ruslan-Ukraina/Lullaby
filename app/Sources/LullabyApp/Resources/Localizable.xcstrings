    "A game is still running. Quit it, then try again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game is still running. Quit it, then try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра ещё работает. Закройте её и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гра ще працює. Закрийте її й спробуйте ще раз."
          }
        }
      }
    },
    "A new engine is out, but Lullaby doesn't support it yet. Try again later.": {
