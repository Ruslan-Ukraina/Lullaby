    "macOS didn't let NotProton change Steam. Allow NotProton under App Management in System Settings, then press Retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn't let NotProton change Steam. Allow NotProton under App Management in System Settings, then press Retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не разрешила NotProton изменить Steam. Разрешите NotProton в Системных настройках → «Управление приложениями» и нажмите «Повторить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не дозволила NotProton змінити Steam. Дозвольте NotProton у Системних параметрах → «Керування програмами» й натисніть «Повторити»."
          }
        }
      },
