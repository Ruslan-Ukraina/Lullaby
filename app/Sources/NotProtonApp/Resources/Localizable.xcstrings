  "strings": {
    "A game is still running. Quit it, then press Retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game is still running. Quit it, then press Retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра ещё работает. Закройте её и нажмите «Повторить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гра ще працює. Закрийте її й натисніть «Повторити»."
          }
        }
      },
      "generatesSymbol": false
    },
    "A new engine is out, but NotProton doesn't support it yet. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new engine is out, but NotProton doesn't support it yet. Try again later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышел новый движок, но NotProton его ещё не поддерживает. Попробуйте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вийшов новий рушій, але NotProton його ще не підтримує. Спробуйте пізніше."
          }
        }
      },
      "generatesSymbol": false
    },
