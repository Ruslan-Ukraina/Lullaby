        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam встановив інший користувач цього Mac. Лише він може встановити в нього NotProton."
          }
        }
      },
      "generatesSymbol": false
    },
    "Steam won't update at all, even to versions NotProton supports. You can turn this back on here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
