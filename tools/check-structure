#!/bin/sh
# Compares the tree with docs/STRUCTURE.md. Read-only. Exit 1 on a difference.
#   tools/check-structure
# Top-level tracked directories must appear in the table as `dir/`; every symlink in
# the tree must appear in the table; table entries for top-level directories must exist.
# Exceptions (one per line, a path or a symlink): tools/check-structure.allow
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd); cd "$repo"
map=docs/STRUCTURE.md; allow=tools/check-structure.allow
[ -f "$map" ] || { echo "check-structure: $map is missing" >&2; exit 1; }
[ -f "$allow" ] || : > "$allow"
fail=0
dirs=$(git ls-files | awk -F/ 'NF>1 {print $1}' | sort -u)
for d in $dirs; do
  grep -qxF "$d" "$allow" && continue
  grep -qF "\`$d/" "$map" || { echo "check-structure: $d/ is not in $map" >&2; fail=1; }
done
git ls-files -s | awk '$1=="120000" {print $4}' | while read -r l; do
  grep -qxF "$l" "$allow" && continue
  n=$(basename "$l"); grep -qF "$n" "$map" || echo "check-structure: link $l is not in $map" >&2
done > /tmp/lby-cs.$$ 2>&1 || true
if [ -s /tmp/lby-cs.$$ ]; then cat /tmp/lby-cs.$$ >&2; fail=1; fi; rm -f /tmp/lby-cs.$$
# table -> tree: first-column entries of the form `name/`
# shellcheck disable=SC2016 # the backticks are literal Markdown
for d in $(grep -oE '^\| `[a-zA-Z0-9._/-]+/`' "$map" | tr -d '|` '); do
  [ -e "$d" ] || { echo "check-structure: $map lists $d/, which does not exist" >&2; fail=1; }
done
# documents -> files: a NAME.md named in docs/*.md or a component README must exist somewhere in the tree, unless its line says "не в репозитории" or the allow file has `doc:NAME.md`
for f in $(git ls-files 'docs/*.md' '*/README.md' | grep -v '^vendor/'); do
  grep -noE '[A-Z][A-Z0-9_]{3,}\.md' "$f" | while IFS=: read -r ln name; do
    if ! git ls-files | grep -qE "(^|/)$name\$"; then
      grep -qxF "doc:$name" "$allow" && continue
      sed -n "${ln}p" "$f" | grep -q 'не в репозитории' && continue
      echo "check-structure: $f:$ln names $name, which is not in the repository" >&2
    fi
  done
done > /tmp/lby-cs2.$$ 2>&1 || true
if [ -s /tmp/lby-cs2.$$ ]; then cat /tmp/lby-cs2.$$ >&2; fail=1; fi; rm -f /tmp/lby-cs2.$$
# links: relative, no user name, target inside the repository and tracked; a link to a folder outside it
# (Steam's compatdata) only when the allow file says `link-outside:<link>` (PROJECT_RULES 2.11)
git ls-files -s | awk '$1=="120000" {print $4}' | while read -r l; do
  tg=$(readlink "$l")
  case "$tg" in /*|*/Users/*) echo "check-structure: link $l has an absolute or personal target ($tg)" >&2; continue ;; esac
  d=$(cd -P "$(dirname "$l")/$(dirname "$tg")" 2>/dev/null && pwd -P) || d=""
  abs="$d/$(basename "$tg")"; rel=${abs#"$repo"/}
  if [ -z "$d" ] || [ "$rel" = "$abs" ]; then
    grep -qxF "link-outside:$l" "$allow" || echo "check-structure: link $l points outside the repository or nowhere ($tg); allow it with link-outside:$l or fix it" >&2
  elif [ -z "$(git ls-files -- "$rel" | head -n 1)" ]; then
    echo "check-structure: link $l points to $rel, which is not tracked" >&2
  fi
done > /tmp/lby-cs3.$$ 2>&1 || true
if [ -s /tmp/lby-cs3.$$ ]; then cat /tmp/lby-cs3.$$ >&2; fail=1; fi; rm -f /tmp/lby-cs3.$$
[ "$fail" -eq 0 ] && echo "==> check-structure: tree and map agree"
exit "$fail"
